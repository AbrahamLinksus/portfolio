---
// A case study told as a case file you open like a book. Closed, it's a manila folder. Opened,
// it shows two pages at a time on wide screens (the case beside the clues, then the evidence
// beside the verdict) and one page at a time on phones. After the verdict it closes again,
// stamped "Solved". Without JavaScript the cover stays hidden and every page shows in order.
import type { Project } from '../lib/projects';

interface Props {
  file: NonNullable<Project['data']['caseFile']>;
  number: string;
  title: string;
}
const { file: f, number, title } = Astro.props;
const hasEvidence = f.exhibits.length > 0 || f.evidence.length > 0;
const hasBefore = f.evidence.some((e) => e.before);
// Tiles fill a page on their own; the table is kept only beside an exhibit photo.
const tiles = !hasBefore || f.exhibits.length === 0;
const pages = ['The case', 'The clues', ...(hasEvidence ? ['The evidence'] : []), 'The verdict'];
const pageNo = (name: string) => pages.indexOf(name) + 1;
---

<section class="file" aria-labelledby={`file-${number}`} data-file>
  <span class="tab" aria-hidden="true">Case {number}</span>

  <div class="cover" data-cover hidden>
    <div class="cv-in">
      <p class="cv-meta">Case file {number}</p>
      <h2 id={`file-${number}`} class="cv-title display">{f.codename}</h2>
      <p class="cv-sub">{title}</p>
      <span class="cv-stamp" data-stamp aria-hidden="true">Confidential</span>
      <button type="button" class="cv-open" data-open>Open the file →</button>
    </div>
  </div>

  <div class="folder" data-folder>
    <p class="f-meta">Case file {number} · {title} · {f.codename}</p>

    <div class="book" data-book>
      <article class="page" data-page aria-label={`Page 1 of ${pages.length}: The case`}>
        <span class="folio">Page 1 of {pages.length}</span>
        <h3 class="f-h">The case</h3>
        <p class="typed">{f.case}</p>
      </article>

      <article class="page" data-page aria-label={`Page 2 of ${pages.length}: The clues`}>
        <span class="folio">Page 2 of {pages.length}</span>
        <h3 class="f-h">The clues</h3>
        <div class="board" data-board>
          <svg class="string" data-string aria-hidden="true"><path d="" /></svg>
          <ol class="clues">
            {
              f.clues.map((c, i) => (
                <li class="clue" style={`--tilt: ${[-1.5, 1.2, -0.8, 1.5][i % 4]}deg`}>
                  <span class="pin" data-pin aria-hidden="true" />
                  <span class="c-n">Clue {i + 1}</span>
                  <p class="c-fact">{c.fact}</p>
                  <p class="c-meant">
                    <span class="arrow" aria-hidden="true">→</span> {c.meant}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
      </article>

      {
        hasEvidence && (
          <article class="page" data-page aria-label={`Page ${pageNo('The evidence')} of ${pages.length}: The evidence`}>
            <span class="folio">Page {pageNo('The evidence')} of {pages.length}</span>
            <h3 class="f-h">The evidence</h3>
            <div class="f-exhibits">
              {f.exhibits.map((e, i) => (
                <figure class="polaroid" style={`--tilt: ${i % 2 ? 2 : -2.5}deg`}>
                  <span class="tape" aria-hidden="true" />
                  <img src={e.src} alt={e.alt} loading="lazy" />
                  <figcaption>{e.caption}</figcaption>
                </figure>
              ))}
              {f.evidence.length > 0 && tiles && (
                <div class="lab">
                  <h4 class="lab-h">Lab results</h4>
                  <ul class="tiles">
                    {f.evidence.map((e) => (
                      <li>
                        <span class="tv">{e.after}</span>
                        {e.before && (
                          <span class="tb">
                            was <s>{e.before}</s>
                          </span>
                        )}
                        <span class="tl">{e.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {f.evidence.length > 0 && !tiles && (
                <div class="lab">
                  <h4 class="lab-h">Lab results</h4>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Measure</th>
                        <th scope="col">Before</th>
                        <th scope="col">Result</th>
                      </tr>
                    </thead>
                    <tbody>
                      {f.evidence.map((e) => (
                        <tr>
                          <th scope="row">{e.label}</th>
                          <td class:list={['before', { none: !e.before }]}>{e.before || '—'}</td>
                          <td class="after">{e.after}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </article>
        )
      }

      <article class="page" data-page aria-label={`Page ${pages.length} of ${pages.length}: The verdict`}>
        <span class="folio">Page {pages.length} of {pages.length}</span>
        <div class="f-verdict">
          <span class="stamp" aria-hidden="true">Solved</span>
          <h3 class="f-h">The verdict</h3>
          <p class="verdict">{f.verdict}</p>
          <p class="lesson"><b>Note to self:</b> {f.lesson}</p>
        </div>
        <p class="end" aria-hidden="true">— End of file —</p>
      </article>
    </div>

    <nav class="flip" aria-label="Case file pages" data-flip hidden>
      <button type="button" class="turn" data-prev>← Back</button>
      <ol class="dots" data-dots></ol>
      <button type="button" class="turn next" data-next>Turn page →</button>
    </nav>
  </div>
</section>

<style>
  .file {
    --paper: #efe4cf;
    --paper-ink: #1d1a16;
    --manila: #e3d3b4;
    --red: #c4202f;
    position: relative;
    padding-top: 30px;
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
  }
  .file.closed {
    max-width: 520px;
  }
  /* Manila folder tab. */
  .tab {
    position: absolute;
    top: 0;
    left: 28px;
    padding: 6px 18px 10px;
    border-radius: 12px 12px 0 0;
    background: var(--manila);
    color: var(--paper-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* The closed folder. */
  .cover {
    position: relative;
    z-index: 2;
    border-radius: 6px 22px 22px 22px;
    background: linear-gradient(135deg, #e7d8ba, #d6c199);
    color: var(--paper-ink);
    box-shadow:
      6px 6px 0 -2px #efe4cf,
      12px 12px 0 -4px #e3d3b4,
      0 16px 40px rgba(0, 0, 0, 0.5);
    transform-origin: left center;
    backface-visibility: hidden;
  }
  .cover[hidden] {
    display: none;
  }
  .cv-in {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 14px;
    min-height: 600px;
    padding: 48px 40px;
  }
  .cv-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4f463b;
  }
  .cv-title {
    font-size: clamp(44px, 6vw, 64px);
    line-height: 0.95;
    text-wrap: balance;
  }
  .cv-sub {
    margin: 0;
    padding-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: #4f463b;
  }
  .cv-stamp {
    position: absolute;
    top: 38px;
    right: 28px;
    padding: 6px 16px 4px;
    border: 4px solid var(--red);
    border-radius: 8px;
    color: var(--red);
    font-family: var(--font-display);
    font-size: 30px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(8deg);
    opacity: 0.85;
  }
  .cv-open {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    padding: 14px 22px;
    border-radius: 12px;
    background: var(--paper-ink);
    color: var(--paper);
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
  }
  .cv-open:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }
  .cover.opening {
    animation: cover-open 0.6s ease-in forwards;
  }
  .cover.closing {
    animation: cover-close 0.55s ease-out;
  }
  @keyframes cover-open {
    to {
      transform: perspective(2000px) rotateY(-100deg);
      opacity: 0;
    }
  }
  @keyframes cover-close {
    from {
      transform: perspective(2000px) rotateY(-100deg);
      opacity: 0;
    }
  }

  /* The open folder. */
  .folder {
    display: grid;
    gap: 18px;
    padding: 22px 26px 22px;
    border-radius: 6px 22px 22px 22px;
    background: var(--manila);
    color: var(--paper-ink);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }
  .folder[hidden] {
    display: none;
  }
  .folder.appear {
    animation: appear 0.35s ease-out;
  }
  @keyframes appear {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
  .f-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4f463b;
  }

  /* Pages: ruled paper sheets. Two at a time on wide screens, meeting at a spine. */
  .book {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    perspective: 2200px;
  }
  /* The open spread is two letter-size pages side by side; both pages share its height. */
  .spread .book {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
  }
  .page {
    position: relative;
    display: grid;
    align-content: start;
    gap: 16px;
    min-width: 0;
    padding: 34px 28px 32px 40px;
    border-radius: 4px 14px 14px 4px;
    background-color: var(--paper);
    background-image:
      linear-gradient(90deg, transparent 22px, rgba(196, 32, 47, 0.28) 22px, rgba(196, 32, 47, 0.28) 23px, transparent 23px),
      linear-gradient(rgba(29, 26, 22, 0.06) 1px, transparent 1px);
    background-size: 100% 100%, 100% 30px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08), 4px 4px 0 -1px #d9c7a4;
    backface-visibility: hidden;
  }
  .page[hidden] {
    display: none;
  }
  .spread .page {
    /* At least a letter-size sheet (8.5 x 11); extra content makes it taller, never wider. */
    min-height: calc(50cqw * 11 / 8.5);
    box-shadow: none;
  }
  .spread .page.left {
    border-radius: 14px 0 0 14px;
    background-image:
      linear-gradient(90deg, transparent calc(100% - 26px), rgba(29, 26, 22, 0.14)),
      linear-gradient(90deg, transparent 22px, rgba(196, 32, 47, 0.28) 22px, rgba(196, 32, 47, 0.28) 23px, transparent 23px),
      linear-gradient(rgba(29, 26, 22, 0.06) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 100% 30px;
    transform-origin: right center;
  }
  .spread .page.right {
    border-radius: 0 14px 14px 0;
    background-image:
      linear-gradient(90deg, rgba(29, 26, 22, 0.16), transparent 26px),
      linear-gradient(90deg, transparent 22px, rgba(196, 32, 47, 0.28) 22px, rgba(196, 32, 47, 0.28) 23px, transparent 23px),
      linear-gradient(rgba(29, 26, 22, 0.06) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 100% 30px;
    transform-origin: left center;
  }
  /* Page turns. On a spread the right page folds over the spine; one-up pages slide. */
  .page.fold-r {
    animation: fold-r 0.32s ease-in forwards;
  }
  .page.unfold-l {
    animation: unfold-l 0.32s ease-out;
  }
  .page.fold-l {
    animation: fold-l 0.32s ease-in forwards;
  }
  .page.unfold-r {
    animation: unfold-r 0.32s ease-out;
  }
  @keyframes fold-r {
    to {
      transform: rotateY(-90deg);
    }
  }
  @keyframes unfold-l {
    from {
      transform: rotateY(90deg);
    }
  }
  @keyframes fold-l {
    to {
      transform: rotateY(90deg);
    }
  }
  @keyframes unfold-r {
    from {
      transform: rotateY(-90deg);
    }
  }
  .page.slide-out {
    animation: slide-out 0.26s ease-in forwards;
  }
  .page.slide-in {
    animation: slide-in 0.3s ease-out;
  }
  @keyframes slide-out {
    to {
      opacity: 0;
      transform: translateX(-24px);
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
  .folio {
    position: absolute;
    top: 12px;
    right: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a7f70;
  }
  .f-h {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }
  .typed {
    margin: 0;
    max-width: 66ch;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.85;
  }
  .end {
    margin: auto 0 0;
    padding-top: 30px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a7f70;
  }

  /* Clues: index cards pinned to the page, joined by red string drawn in script. */
  .board {
    position: relative;
  }
  .string {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 2;
  }
  .string path {
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .clues {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    display: grid;
    gap: 22px;
  }
  .clue {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    padding: 24px 18px 16px;
    background: #fffdf7;
    background-image: linear-gradient(transparent 31px, rgba(196, 32, 47, 0.35) 31px, rgba(196, 32, 47, 0.35) 32px, transparent 32px);
    border-radius: 3px;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.15), 0 8px 18px rgba(0, 0, 0, 0.12);
    transform: rotate(var(--tilt));
  }
  .pin {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff6b74, var(--red) 60%, #7d1019);
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.35);
    z-index: 3;
  }
  .c-n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
  }
  .c-fact {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 17px;
    line-height: 1.25;
  }
  .c-meant {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: #3d372f;
  }
  .arrow {
    color: var(--red);
    font-weight: 700;
  }

  /* Evidence */
  .f-exhibits {
    display: grid;
    gap: 26px;
    align-items: start;
  }
  .polaroid {
    position: relative;
    margin: 8px 0 0;
    padding: 10px 10px 12px;
    background: #fff;
    transform: rotate(var(--tilt));
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }
  .polaroid img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .polaroid figcaption {
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: #3d372f;
  }
  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 90px;
    height: 22px;
    margin-left: -45px;
    background: rgba(246, 210, 58, 0.75);
    transform: rotate(3deg);
  }
  .lab {
    min-width: 0;
  }
  .lab-h {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5a5045;
  }
  .lab table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .lab th,
  .lab td {
    padding: 10px 6px;
    border-bottom: 1px solid rgba(29, 26, 22, 0.2);
    text-align: left;
    font-size: 14.5px;
    vertical-align: top;
  }
  .lab thead th {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5a5045;
  }
  .lab tbody th {
    font-weight: 500;
  }
  .lab td {
    font-family: var(--font-mono);
    font-size: 13.5px;
  }
  .lab td.after {
    font-weight: 600;
    white-space: nowrap;
  }
  .lab td.after::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--c);
    vertical-align: 1px;
  }
  /* Stat tiles, like index cards: big result, small label. */
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 12px;
  }
  .tiles li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 14px 16px 16px;
    border-radius: 4px;
    background: #fffdf7;
    border-top: 5px solid var(--c);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.12);
  }
  .tv {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.05;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .tb {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #5a5045;
  }
  .tb s {
    text-decoration-color: var(--red);
  }
  .tl {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5a5045;
  }

  /* Verdict with a rubber stamp. */
  .f-verdict {
    position: relative;
    margin-top: 44px;
    padding: 22px;
    border: 2px solid var(--paper-ink);
    border-radius: 4px;
  }
  .stamp {
    position: absolute;
    right: 16px;
    top: -26px;
    padding: 6px 16px 4px;
    border: 4px solid var(--red);
    border-radius: 8px;
    color: var(--red);
    font-family: var(--font-display);
    font-size: 36px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-9deg);
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    opacity: 0.92;
  }
  .verdict {
    margin: 12px 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 19px;
    line-height: 1.35;
  }
  .lesson {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: #3d372f;
  }

  /* Controls: back / dots / turn page (becomes "Close the file" at the end). */
  .flip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }
  .flip[hidden] {
    display: none;
  }
  .turn {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    padding: 10px 16px;
    border-radius: 10px;
    border: 2px solid var(--paper-ink);
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
  }
  .turn.next {
    background: var(--paper-ink);
    color: var(--paper);
  }
  .turn:focus-visible,
  .dots :global(button:focus-visible) {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }
  .dots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .dots :global(button) {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid #5a5045;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #5a5045;
  }
  .dots :global(button[aria-current='step']) {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }

  @media (max-width: 640px) {
    .file {
      margin-inline: -10px;
      width: auto;
    }
    .file.closed {
      max-width: none;
    }
    .tab {
      left: 18px;
    }
    .cv-in {
      min-height: 440px;
      padding: 40px 24px;
    }
    .cv-stamp {
      top: 22px;
      right: 16px;
      font-size: 22px;
    }
    .folder {
      padding: 18px 8px 14px;
      gap: 14px;
      border-radius: 6px 18px 18px 18px;
    }
    .f-meta {
      padding-inline: 8px;
    }
    .page {
      gap: 14px;
      padding: 34px 14px 24px 24px;
      background-image:
        linear-gradient(90deg, transparent 12px, rgba(196, 32, 47, 0.28) 12px, rgba(196, 32, 47, 0.28) 13px, transparent 13px),
        linear-gradient(rgba(29, 26, 22, 0.06) 1px, transparent 1px);
    }
    .typed {
      font-size: 15px;
    }
    .clues {
      padding-left: 12px;
    }
    .f-verdict {
      padding: 46px 16px 18px;
    }
    .stamp {
      font-size: 28px;
      top: -18px;
      right: 12px;
    }
    .verdict {
      font-size: 18px;
    }
    .lab table,
    .lab tbody {
      display: block;
    }
    .lab thead {
      display: none;
    }
    .lab tr {
      display: grid;
      grid-template-columns: auto auto 1fr;
      align-items: baseline;
      gap: 4px 12px;
      padding: 12px 0;
      border-bottom: 1px solid rgba(29, 26, 22, 0.2);
    }
    .lab th,
    .lab td {
      padding: 0;
      border: 0;
    }
    .lab tbody th {
      grid-column: 1 / -1;
      font-size: 15px;
    }
    .lab td.before.none {
      display: none;
    }
    .lab td.before {
      color: #6a6155;
      text-decoration: line-through;
      text-decoration-color: rgba(196, 32, 47, 0.6);
    }
    .flip {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'dots dots'
        'prev next';
      gap: 10px;
      padding-inline: 4px;
    }
    .flip .dots {
      grid-area: dots;
    }
    .turn[data-prev] {
      grid-area: prev;
    }
    .turn.next {
      grid-area: next;
    }
    .turn {
      padding: 12px 10px;
    }
    .dots :global(button) {
      width: 30px;
      height: 30px;
      font-size: 13px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover.opening,
    .cover.closing,
    .folder.appear,
    .page.fold-r,
    .page.unfold-l,
    .page.fold-l,
    .page.unfold-r,
    .page.slide-out,
    .page.slide-in {
      animation: none;
    }
  }
</style>

<script>
  // Red string through the pins: along the pin line at the top of each card, joined by a rail
  // down the left margin, so it never crosses the text.
  const drawStrings = () =>
    document.querySelectorAll<HTMLElement>('[data-board]').forEach((board) => {
      const svg = board.querySelector<SVGSVGElement>('[data-string]')!;
      const box = board.getBoundingClientRect();
      if (!box.width) return;
      const cards = Array.from(board.querySelectorAll<HTMLElement>('.clue')).map((c) => {
        const pin = c.querySelector<HTMLElement>('[data-pin]')!.getBoundingClientRect();
        const r = c.getBoundingClientRect();
        return { x: pin.left + pin.width / 2 - box.left, y: pin.top + pin.height / 2 - box.top, left: r.left - box.left, right: r.right - box.left };
      });
      if (cards.length < 2) return;
      const rows: (typeof cards)[] = [];
      for (const c of cards) {
        const row = rows.find((r) => Math.abs(r[0].y - c.y) < 30);
        row ? row.push(c) : rows.push([c]);
      }
      const multi = rows.some((r) => r.length > 1);
      const railX = multi ? (rows[0][0].right + rows[0][1].left) / 2 : 4;
      let d = '';
      rows.forEach((row) => {
        const y = row.reduce((s, c) => s + c.y, 0) / row.length;
        const xs = [railX, ...row.map((c) => c.x)].sort((a, b) => a - b);
        d += ` M${xs[0]},${y}`;
        for (let i = 1; i < xs.length; i++) d += ` Q${(xs[i - 1] + xs[i]) / 2},${y + 4} ${xs[i]},${y}`;
      });
      const ys = rows.map((r) => r[0].y);
      d += ` M${railX},${Math.min(...ys)} L${railX},${Math.max(...ys)}`;
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.querySelector('path')!.setAttribute('d', d);
    });

  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const wide = window.matchMedia('(min-width: 900px)');
  const later = (ms: number) => new Promise((r) => setTimeout(r, still.matches ? 0 : ms));

  document.querySelectorAll<HTMLElement>('[data-file]').forEach((file) => {
    const cover = file.querySelector<HTMLElement>('[data-cover]')!;
    const folder = file.querySelector<HTMLElement>('[data-folder]')!;
    const pages = Array.from(file.querySelectorAll<HTMLElement>('[data-page]'));
    const nav = file.querySelector<HTMLElement>('[data-flip]')!;
    const prev = nav.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = nav.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = nav.querySelector<HTMLElement>('[data-dots]')!;
    const stamp = cover.querySelector<HTMLElement>('[data-stamp]')!;
    const openBtn = cover.querySelector<HTMLButtonElement>('[data-open]')!;
    let view = 0, busy = false, read = false;

    // A view is two pages on wide screens, one on phones.
    const per = () => (wide.matches ? 2 : 1);
    const views = () => Math.ceil(pages.length / per());
    const shown = (v: number) => pages.slice(v * per(), v * per() + per());

    const sync = () => {
      file.classList.toggle('spread', wide.matches);
      const on = shown(view);
      pages.forEach((p) => {
        const i = on.indexOf(p);
        p.hidden = i < 0;
        p.classList.toggle('left', wide.matches && i === 0);
        p.classList.toggle('right', wide.matches && i === 1);
      });
      dots.innerHTML = '';
      for (let v = 0; v < views(); v++) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = String(v + 1);
        const names = shown(v).map((p) => (p.getAttribute('aria-label') ?? '').split(': ')[1]).join(' and ');
        b.setAttribute('aria-label', names);
        if (v === view) b.setAttribute('aria-current', 'step');
        b.addEventListener('click', () => go(v));
        li.appendChild(b);
        dots.appendChild(li);
      }
      prev.textContent = view === 0 ? '← Close' : '← Back';
      next.textContent = view === views() - 1 ? 'Close the file' : 'Turn page →';
      requestAnimationFrame(drawStrings);
    };

    const go = async (to: number) => {
      if (busy || to === view || to < 0 || to >= views()) return;
      busy = true;
      if (file.getBoundingClientRect().top < 0) file.scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth', block: 'start' });
      const fwd = to > view;
      const cur = shown(view);
      if (wide.matches) {
        const leaving = fwd ? cur[cur.length - 1] : cur[0];
        leaving.classList.add(fwd ? 'fold-r' : 'fold-l');
        await later(300);
        leaving.classList.remove('fold-r', 'fold-l');
        view = to;
        sync();
        const arriving = fwd ? shown(view)[0] : shown(view)[shown(view).length - 1];
        arriving?.classList.add(fwd ? 'unfold-l' : 'unfold-r');
        await later(320);
        arriving?.classList.remove('unfold-l', 'unfold-r');
      } else {
        cur[0].classList.add('slide-out');
        await later(240);
        cur[0].classList.remove('slide-out');
        view = to;
        sync();
        shown(view)[0].classList.add('slide-in');
        await later(300);
        shown(view)[0].classList.remove('slide-in');
      }
      busy = false;
    };

    const open = async () => {
      if (busy) return;
      busy = true;
      cover.classList.add('opening');
      await later(560);
      cover.classList.remove('opening');
      cover.hidden = true;
      file.classList.remove('closed');
      folder.hidden = false;
      folder.classList.add('appear');
      view = 0;
      sync();
      await later(350);
      folder.classList.remove('appear');
      busy = false;
      next.focus({ preventScroll: true });
    };
    const close = async () => {
      if (busy) return;
      busy = true;
      if (view === views() - 1) read = true;
      folder.hidden = true;
      file.classList.add('closed');
      cover.hidden = false;
      stamp.textContent = read ? 'Solved' : 'Confidential';
      openBtn.textContent = read ? 'Read it again →' : 'Open the file →';
      cover.classList.add('closing');
      if (file.getBoundingClientRect().top < 0) file.scrollIntoView({ behavior: still.matches ? 'auto' : 'smooth', block: 'start' });
      await later(550);
      cover.classList.remove('closing');
      busy = false;
      openBtn.focus({ preventScroll: true });
    };

    prev.addEventListener('click', () => (view === 0 ? close() : go(view - 1)));
    next.addEventListener('click', () => (view === views() - 1 ? close() : go(view + 1)));
    openBtn.addEventListener('click', open);
    file.addEventListener('keydown', (e) => {
      if (folder.hidden) return;
      if (e.key === 'ArrowRight') view === views() - 1 ? close() : go(view + 1);
      if (e.key === 'ArrowLeft') go(view - 1);
    });
    let x0 = 0, y0 = 0;
    const book = file.querySelector<HTMLElement>('[data-book]')!;
    book.addEventListener('touchstart', (e) => ((x0 = e.touches[0].clientX), (y0 = e.touches[0].clientY)), { passive: true });
    book.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) go(view + (dx < 0 ? 1 : -1));
    });
    wide.addEventListener('change', () => {
      view = Math.min(view, views() - 1);
      if (!folder.hidden) sync();
    });

    // Start closed. Without JavaScript none of this runs, so every page simply shows.
    nav.hidden = false;
    folder.hidden = true;
    cover.hidden = false;
    file.classList.add('closed');
  });

  window.addEventListener('resize', drawStrings);
  document.fonts?.ready.then(drawStrings);
</script>
