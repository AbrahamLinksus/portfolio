---
// Switches between dark and light. The initial theme is set in BaseLayout's head script.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light mode">
  <span class="track" aria-hidden="true"><span class="knob"></span></span>
</button>

<style>
  .theme-toggle {
    all: unset;
    cursor: pointer;
    padding: 8px;
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 2px;
    border-radius: 99px;
  }
  .track {
    display: block;
    width: 36px;
    height: 20px;
    border-radius: 99px;
    border: 1.5px solid var(--fg);
    position: relative;
  }
  .knob {
    position: absolute;
    top: 2.5px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fg);
    transition: transform 0.2s ease;
  }
  :global(:root[data-theme='light']) .knob {
    transform: translateX(15px);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const label = () => {
    const isLight = document.documentElement.dataset.theme === 'light';
    buttons.forEach((b) => b.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode'));
  };
  label();
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      label();
    }),
  );
</script>
