---
// Stylised map of rides from one starting point. Places are plotted from real coordinates;
// the coastline is a rough sketch for orientation only.
import { km } from '../lib/geo';

type Side = 'left' | 'right' | 'above' | 'below' | 'below-left' | 'right-up';
interface Place {
  name: string;
  lat: number;
  lon: number;
  longest?: boolean;
  label?: Side;
  bend?: number;
}
interface Props {
  home: { name: string; lat: number; lon: number; tag: string };
  places: Place[];
  view: { lon0: number; lon1: number; lat0: number; lat1: number };
  regions?: { text: string; lat: number; lon: number; rotate?: number; sea?: boolean }[];
  homeLabel?: Side;
}
const { home, places, view, regions = [], homeLabel = 'right' } = Astro.props;

const PAD = 30, INNER = 640;
const KX = INNER / (view.lon1 - view.lon0);
const KY = KX / Math.cos((((view.lat0 + view.lat1) / 2) * Math.PI) / 180);
const x = (lon: number) => PAD + (lon - view.lon0) * KX;
const y = (lat: number) => PAD + (view.lat1 - lat) * KY;
const W = Math.ceil(INNER + PAD * 2), H = Math.ceil((view.lat1 - view.lat0) * KY + PAD * 2);
const uid = home.name.toLowerCase().replace(/[^a-z]/g, '');

// Rough coastline of the southern peninsula: west coast north to south, then east coast back up.
const coast: [number, number][] = [
  [15.5, 73.8], [13.6, 74.6], [12.9, 74.85], [12.0, 75.3], [11.25, 75.78], [10.5, 76.0], [9.9, 76.25], [9.0, 76.5], [8.5, 76.95], [8.08, 77.54],
  [8.8, 78.15], [9.3, 79.2], [10.3, 79.85], [11.0, 79.85], [11.93, 79.83], [12.62, 80.2], [13.08, 80.29], [13.45, 80.33], [13.75, 80.25], [14.5, 80.15], [15.5, 80.1],
  [15.5, 73.8],
];
const land = 'M' + coast.map(([la, lo]) => `${x(lo).toFixed(1)},${y(la).toFixed(1)}`).join('L') + 'Z';
const hx = x(home.lon), hy = y(home.lat);

// Label offsets for each side of a pin: name line, then distance line.
const place = (px: number, py: number, side: Side, gap = 14) => {
  if (side === 'left') return { tx: px - gap, ny: py - 2, dy: py + 14, anchor: 'end' };
  if (side === 'above') return { tx: px, ny: py - 28, dy: py - 13, anchor: 'middle' };
  if (side === 'right-up') return { tx: px + gap, ny: py - 10, dy: py + 5, anchor: 'start' };
  if (side === 'below-left') return { tx: px + 8, ny: py + 34, dy: py + 49, anchor: 'end' };
  if (side === 'below') return { tx: px, ny: py + 27, dy: py + 42, anchor: 'middle' };
  return { tx: px + gap, ny: py - 2, dy: py + 14, anchor: 'start' };
};

const routes = places.map((p, i) => {
  const px = x(p.lon), py = y(p.lat);
  const k = p.bend ?? 0.15;
  const mx = (hx + px) / 2 + (py - hy) * k, my = (hy + py) / 2 - (px - hx) * k;
  return {
    ...p, px, py,
    d: `M${hx.toFixed(1)},${hy.toFixed(1)} Q${mx.toFixed(1)},${my.toFixed(1)} ${px.toFixed(1)},${py.toFixed(1)}`,
    dist: km(home, p),
    l: place(px, py, p.label ?? 'right'),
    n: String(i + 1).padStart(2, '0'),
    side: p.label ?? 'right',
  };
});
const hl = place(hx, hy, homeLabel, 18);
---

<svg class="ridemap" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Ride map from ${home.name}: ${routes.map((r) => `${r.name}, ${r.dist} km away`).join('; ')}`}>
  <defs>
    <pattern id={`grid-${uid}`} width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="rgba(242,236,228,.06)" stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width={W} height={H} class="sea"></rect>
  <rect width={W} height={H} fill={`url(#grid-${uid})`}></rect>
  <path d={land} class="land"></path>
  {
    regions.map((r) => (
      <text class:list={['region', { sea: r.sea }]} x={x(r.lon)} y={y(r.lat)} transform={r.rotate ? `rotate(${r.rotate} ${x(r.lon)} ${y(r.lat)})` : undefined}>
        {r.text}
      </text>
    ))
  }
  {routes.map((r) => <path d={r.d} class:list={['route', { longest: r.longest }]} />)}
  {
    routes.map((r) => (
      <g class:list={['pin', { longest: r.longest }]}>
        <circle cx={r.px} cy={r.py} r={r.longest ? 8 : 6} />
        <text class="pn" x={r.l.tx} y={r.l.ny} text-anchor={r.l.anchor}>{r.name}</text>
        <text class="pnum" x={r.l.tx} y={['left', 'right', 'right-up'].includes(r.side) ? r.py + 9 : r.l.ny} text-anchor={r.l.anchor}>{r.n}</text>
        <text class="pd" x={r.l.tx} y={r.l.dy} text-anchor={r.l.anchor}>
          {r.longest ? 'LONGEST RIDE · ' : ''}{r.dist} KM
        </text>
      </g>
    ))
  }
  <g class="home">
    <circle cx={hx} cy={hy} r="13" class="halo"></circle>
    <circle cx={hx} cy={hy} r="7"></circle>
    <text class="hn" x={hl.tx} y={hy + 5} text-anchor={hl.anchor}>{home.name.toUpperCase()} · {home.tag}</text>
  </g>
</svg>

<style>
  .ridemap {
    display: block;
    width: 100%;
    height: auto;
  }
  .sea {
    fill: #151313;
  }
  .land {
    fill: #2a221c;
    stroke: rgba(242, 236, 228, 0.35);
    stroke-width: 1.5;
  }
  .region {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    fill: rgba(242, 236, 228, 0.28);
  }
  .region.sea {
    fill: rgba(92, 200, 192, 0.35);
  }
  .route {
    fill: none;
    stroke: #ff8a1f;
    stroke-width: 2.5;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .route.longest {
    stroke-width: 3.5;
    stroke-dasharray: none;
  }
  .pin circle {
    fill: #ff8a1f;
    stroke: #151313;
    stroke-width: 3;
  }
  .pn {
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 16px;
    text-transform: uppercase;
    fill: #f2ece4;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .pd {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    fill: #ffb878;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
  }
  .pnum {
    display: none;
    font-family: var(--font-display);
    font-size: 30px;
    fill: #f2ece4;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 6px;
  }
  .home circle {
    fill: #f2ece4;
  }
  .home .halo {
    fill: rgba(255, 138, 31, 0.25);
  }
  .hn {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    fill: #f2ece4;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
  }
  @media (max-width: 600px) {
    .pn {
      display: none;
    }
    .pnum {
      display: inline;
    }
    .pd {
      display: none;
    }
    .hn {
      font-size: 18px;
      stroke-width: 6px;
    }
    .region {
      font-size: 16px;
    }
  }
</style>
