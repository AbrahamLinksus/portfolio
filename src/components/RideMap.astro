---
// Stylised map of rides from one or more starting points. Places are plotted from real
// coordinates; the coastline is a rough sketch for orientation only.
import { km } from '../lib/geo';

type Side = 'left' | 'right' | 'above' | 'below';
interface Home {
  name: string;
  lat: number;
  lon: number;
  tag: string;
}
interface Place {
  name: string;
  lat: number;
  lon: number;
  from: string;
  label?: Side;
  /** Move the label away from the pin (with a pointer line), in map units. */
  offset?: [number, number];
  bend?: number;
}
interface Props {
  homes: Home[];
  places: Place[];
  view: { lon0: number; lon1: number; lat0: number; lat1: number };
  regions?: { text: string; lat: number; lon: number; rotate?: number; sea?: boolean }[];
}
const { homes, places, view, regions = [] } = Astro.props;

const PAD = 30, INNER = 640;
const KX = INNER / (view.lon1 - view.lon0);
const KY = KX / Math.cos((((view.lat0 + view.lat1) / 2) * Math.PI) / 180);
const x = (lon: number) => PAD + (lon - view.lon0) * KX;
const y = (lat: number) => PAD + (view.lat1 - lat) * KY;
const W = Math.ceil(INNER + PAD * 2), H = Math.ceil((view.lat1 - view.lat0) * KY + PAD * 2);

// Rough coastline of the southern peninsula: west coast north to south, then east coast back up.
const coast: [number, number][] = [
  [15.5, 73.8], [13.6, 74.6], [12.9, 74.85], [12.0, 75.3], [11.25, 75.78], [10.5, 76.0], [9.9, 76.25], [9.0, 76.5], [8.5, 76.95], [8.08, 77.54],
  [8.8, 78.15], [9.3, 79.2], [10.3, 79.85], [11.0, 79.85], [11.93, 79.83], [12.62, 80.2], [13.08, 80.29], [13.45, 80.33], [13.75, 80.25], [14.5, 80.15], [15.5, 80.1],
  [15.5, 73.8],
];
const land = 'M' + coast.map(([la, lo]) => `${x(lo).toFixed(1)},${y(la).toFixed(1)}`).join('L') + 'Z';

// Name line, then distance line, on the chosen side of a point.
const lines = (px: number, py: number, side: Side, gap = 13) => {
  if (side === 'left') return { tx: px - gap, ny: py - 1, dy: py + 14, anchor: 'end' };
  if (side === 'above') return { tx: px, ny: py - 24, dy: py - 10, anchor: 'middle' };
  if (side === 'below') return { tx: px, ny: py + 25, dy: py + 39, anchor: 'middle' };
  return { tx: px + gap, ny: py - 1, dy: py + 14, anchor: 'start' };
};

const homeAt = Object.fromEntries(homes.map((h) => [h.name, { ...h, hx: x(h.lon), hy: y(h.lat) }]));
const routes = places.map((p) => {
  const h = homeAt[p.from];
  const px = x(p.lon), py = y(p.lat);
  const k = p.bend ?? 0.12;
  const mx = (h.hx + px) / 2 + (py - h.hy) * k, my = (h.hy + py) / 2 - (px - h.hx) * k;
  const side = p.label ?? 'right';
  const ax = px + (p.offset?.[0] ?? 0), ay = py + (p.offset?.[1] ?? 0);
  return {
    ...p, px, py, ax, ay,
    d: `M${h.hx.toFixed(1)},${h.hy.toFixed(1)} Q${mx.toFixed(1)},${my.toFixed(1)} ${px.toFixed(1)},${py.toFixed(1)}`,
    dist: km(h, p),
    l: lines(ax, ay, side, p.offset ? 4 : 13),
  };
});
---

<svg class="ridemap" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Ride map. ${homes.map((h) => `From ${h.name}: ${routes.filter((r) => r.from === h.name).map((r) => `${r.name}, ${r.dist} km`).join(', ')}`).join('. ')}`}>
  <defs>
    <pattern id="ride-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="rgba(242,236,228,.06)" stroke-width="1"></path>
    </pattern>
  </defs>
  <rect width={W} height={H} class="sea"></rect>
  <rect width={W} height={H} fill="url(#ride-grid)"></rect>
  <path d={land} class="land"></path>
  {
    regions.map((r) => (
      <text class:list={['region', { sea: r.sea }]} x={x(r.lon)} y={y(r.lat)} transform={r.rotate ? `rotate(${r.rotate} ${x(r.lon)} ${y(r.lat)})` : undefined}>
        {r.text}
      </text>
    ))
  }
  {routes.map((r) => <path d={r.d} class="route" />)}
  {routes.filter((r) => r.offset).map((r) => <line x1={r.px} y1={r.py} x2={r.ax} y2={r.ay} class="leader" />)}
  {
    routes.map((r) => (
      <g class="pin">
        <circle cx={r.px} cy={r.py} r="5.5" />
        <text class="pn" x={r.l.tx} y={r.l.ny} text-anchor={r.l.anchor}>{r.name}</text>
        <text class="pd" x={r.l.tx} y={r.l.dy} text-anchor={r.l.anchor}>{r.dist} KM</text>
      </g>
    ))
  }
  {
    Object.values(homeAt).map((h) => (
      <g class="home">
        <circle cx={h.hx} cy={h.hy} r="13" class="halo" />
        <circle cx={h.hx} cy={h.hy} r="7" />
        <text class="hn" x={h.hx + 18} y={h.hy - 1}>{h.name.toUpperCase()}</text>
        <text class="ht" x={h.hx + 18} y={h.hy + 14}>{h.tag}</text>
      </g>
    ))
  }
</svg>

<style>
  .ridemap {
    display: block;
    width: 100%;
    height: auto;
  }
  .sea {
    fill: #151313;
  }
  .land {
    fill: #2a221c;
    stroke: rgba(242, 236, 228, 0.35);
    stroke-width: 1.5;
  }
  .region {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    fill: rgba(242, 236, 228, 0.28);
  }
  .region.sea {
    fill: rgba(92, 200, 192, 0.35);
  }
  .route {
    fill: none;
    stroke: #ff8a1f;
    stroke-width: 2.2;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .leader {
    stroke: rgba(242, 236, 228, 0.45);
    stroke-width: 1;
  }
  .pin circle {
    fill: #ff8a1f;
    stroke: #151313;
    stroke-width: 3;
  }
  .pn {
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    fill: #f2ece4;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .pd,
  .ht {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    fill: #ffb878;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
  }
  .home circle {
    fill: #f2ece4;
  }
  .home .halo {
    fill: rgba(255, 138, 31, 0.25);
  }
  .hn {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    fill: #f2ece4;
    paint-order: stroke;
    stroke: #151313;
    stroke-width: 4px;
  }
</style>
