---
// Toy for QueuedUp: review one card, grade yourself, and watch the interval grow. The scheduler
// here is a classic SM-2 style rule written as a pure function, with the current time passed in,
// which is the design QueuedUp's scheduler follows.
import ToyShell from './ToyShell.astro';
const cards = [
  { kind: 'Flashcard', front: 'der Hund', back: 'the dog' },
  { kind: 'Code exercise', front: 'Reverse a linked list in O(1) extra space', back: 'Walk it once, flipping each next pointer' },
  { kind: 'Short answer', front: 'Why use row-level security instead of app-side filters?', back: 'The database enforces it, even on a query I forgot to filter' },
];
---

<ToyShell
  kicker="Try it · a pure scheduler"
  title="Grade it, watch it grow"
  lede="Any card you can grade yourself on works. Reveal the answer, grade how it went, and the scheduler picks the next review. Time is passed in, so every review can be replayed."
>
  <div class="qu" data-qu data-cards={JSON.stringify(cards)}>
    <div class="cardcol">
      <div class="kinds" role="group" aria-label="Card type">
        {cards.map((c, i) => (
          <button type="button" class="kind" data-kind={i} aria-pressed={i === 0 ? 'true' : 'false'}>{c.kind}</button>
        ))}
      </div>
      <div class="card" data-card>
        <span class="c-kind" data-ckind>{cards[0].kind}</span>
        <span class="c-front" data-front>{cards[0].front}</span>
        <span class="c-back" data-back hidden>{cards[0].back}</span>
        <button type="button" class="reveal" data-reveal>Show answer</button>
      </div>
      <div class="grades" data-grades hidden>
        <button type="button" class="g again" data-q="1">Again</button>
        <button type="button" class="g" data-q="3">Hard</button>
        <button type="button" class="g good" data-q="4">Good</button>
        <button type="button" class="g" data-q="5">Easy</button>
      </div>
      <code class="call" data-call>schedule(card, grade, now = 10 Nov 2026)</code>
    </div>

    <div class="histcol">
      <div class="next">
        <span class="lbl">Next review</span>
        <span class="n-big" data-next>Now</span>
        <span class="n-date" data-date>Today, 10 Nov</span>
      </div>
      <span class="lbl">Interval after each review</span>
      <ol class="bars" data-bars><li class="empty">Grade the card to start.</li></ol>
      <button type="button" class="reset" data-reset>Start over</button>
    </div>
  </div>
  <Fragment slot="moral">
    <b>Why pure:</b> the scheduler can't touch the database, do any I/O, or read the clock. The time is an argument,
    so any review history can be replayed exactly. Who sees which card is enforced by Postgres row-level security, not
    by remembering to filter every query.
  </Fragment>
</ToyShell>

<style>
  .qu {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 26px;
  }
  .cardcol,
  .histcol {
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .kind {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    padding: 6px 12px;
    border-radius: 99px;
    border: 1.5px solid var(--line);
    font-size: 13px;
  }
  .kind[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .card {
    display: grid;
    gap: 8px;
    min-height: 190px;
    align-content: start;
    padding: 20px;
    border-radius: 16px;
    background: var(--panel);
    color: var(--ink);
    transform: rotate(-1deg);
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
  }
  .c-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5e5a55;
  }
  .c-front {
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.25;
  }
  .c-back {
    padding-top: 10px;
    border-top: 1.5px dashed rgba(17, 17, 18, 0.3);
    font-size: 16px;
    line-height: 1.5;
  }
  .c-back[hidden] {
    display: none;
  }
  .reveal {
    all: unset;
    pointer-events: auto;
    justify-self: start;
    cursor: pointer;
    margin-top: 6px;
    padding: 9px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--panel);
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
  }
  .reveal[hidden] {
    display: none;
  }
  .grades {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .grades[hidden] {
    display: none;
  }
  .g {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    padding: 11px 6px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    text-align: center;
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
  }
  .g.again {
    border-color: #c4202f;
  }
  .g.good {
    background: var(--c);
    border-color: var(--c);
    color: var(--ink);
  }
  .kind:focus-visible,
  .reveal:focus-visible,
  .g:focus-visible,
  .reset:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 3px;
  }
  .call {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .lbl {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .next {
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--bg);
  }
  .n-big {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--c);
  }
  .n-date {
    font-size: 14px;
    color: var(--muted);
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .bars :global(li) {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) 70px;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  .bars :global(li.empty) {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }
  .bars :global(.gname) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .bars :global(.track) {
    height: 12px;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
  }
  .bars :global(.track i) {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: var(--c);
  }
  .bars :global(li.lapse .track i) {
    background: #c4202f;
  }
  .bars :global(.days) {
    font-family: var(--font-mono);
    font-size: 12.5px;
    text-align: right;
  }
  .reset {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    justify-self: start;
    font-size: 13px;
    color: var(--muted);
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .qu {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type Card = { kind: string; front: string; back: string };
  const DAY = 864e5;
  // A pure SM-2 style scheduler: no I/O, no clock. Everything it needs is passed in.
  function schedule(s: { reps: number; ease: number; interval: number }, q: number, now: number) {
    let { reps, ease, interval } = s;
    if (q < 3) {
      reps = 0;
      interval = 1;
    } else {
      interval = reps === 0 ? 1 : reps === 1 ? 6 : Math.round(interval * (q === 3 ? 1.2 : ease));
      reps++;
    }
    ease = Math.max(1.3, ease + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02)));
    return { reps, ease, interval, due: now + interval * DAY };
  }
  document.querySelectorAll<HTMLElement>('[data-qu]').forEach((root) => {
    const cards: Card[] = JSON.parse(root.dataset.cards!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const fmt = (t: number) => new Date(t).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const START = Date.UTC(2026, 10, 10);
    const NAMES: Record<string, string> = { '1': 'Again', '3': 'Hard', '4': 'Good', '5': 'Easy' };
    let state = { reps: 0, ease: 2.5, interval: 0 }, now = START, hist: { q: string; interval: number }[] = [];

    const show = (revealed: boolean) => {
      $('[data-back]').hidden = !revealed;
      $('[data-reveal]').hidden = revealed;
      $('[data-grades]').hidden = !revealed;
    };
    const paint = () => {
      $('[data-call]').textContent = `schedule(card, grade, now = ${fmt(now)})`;
      const ol = $('[data-bars]');
      ol.innerHTML = '';
      if (!hist.length) ol.innerHTML = '<li class="empty">Grade the card to start.</li>';
      const max = Math.max(...hist.map((h) => h.interval), 1);
      hist.forEach((h) => {
        const li = document.createElement('li');
        if (h.q === '1') li.className = 'lapse';
        li.innerHTML = `<span class="gname">${NAMES[h.q]}</span><span class="track"><i style="width:${Math.max(4, (h.interval / max) * 100)}%"></i></span><span class="days">${h.interval} day${h.interval === 1 ? '' : 's'}</span>`;
        ol.appendChild(li);
      });
    };
    const reset = () => {
      state = { reps: 0, ease: 2.5, interval: 0 };
      now = START;
      hist = [];
      $('[data-next]').textContent = 'Now';
      $('[data-date]').textContent = `Today, ${fmt(now)}`;
      show(false);
      paint();
    };
    $('[data-reveal]').addEventListener('click', () => show(true));
    root.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) =>
      b.addEventListener('click', () => {
        const r = schedule(state, Number(b.dataset.q), now);
        state = r;
        hist.push({ q: b.dataset.q!, interval: r.interval });
        $('[data-next]').textContent = `In ${r.interval} day${r.interval === 1 ? '' : 's'}`;
        $('[data-date]').textContent = fmt(r.due);
        now = r.due; // Jump to the day the card comes back.
        show(false);
        paint();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) =>
      b.addEventListener('click', () => {
        const c = cards[Number(b.dataset.kind)];
        root.querySelectorAll('[data-kind]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        $('[data-ckind]').textContent = c.kind;
        $('[data-front]').textContent = c.front;
        $('[data-back]').textContent = c.back;
        reset();
      }),
    );
    $('[data-reset]').addEventListener('click', reset);
    reset();
  });
</script>
