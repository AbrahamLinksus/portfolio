---
import { nav, site } from '../site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<dialog id="site-menu" class="menu" aria-label="Site menu">
  <div class="menu-bar">
    <a class="menu-home" href="/"><span class="mark" aria-hidden="true"></span><span>{site.name.split(' ')[0]}<br />{site.name.split(' ').slice(1).join(' ')}</span></a>
    <button class="menu-close" type="button" data-menu-close>Close <span aria-hidden="true">×</span></button>
  </div>
  <nav class="cols" aria-label="Main">
    {
      nav.map((item, i) => (
        <a
          class="col"
          href={item.href}
          style={`--c: ${item.color}`}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
        >
          <span class="letter" aria-hidden="true">{item.letter}</span>
          <span class="meta">
            <span class="name">{item.label}</span>
            <span class="desc">{item.description}</span>
          </span>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))
    }
  </nav>
</dialog>

<style>
  .menu {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--menu-bg);
    color: var(--ink);
  }
  .menu::backdrop {
    background: var(--menu-bg);
  }
  .menu[open] {
    display: block;
  }
  .menu-bar {
    position: absolute;
    z-index: 2;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(16px + env(safe-area-inset-top, 0px)) var(--gutter-r) 0 var(--gutter-l);
    pointer-events: none;
  }
  .menu-bar > * {
    pointer-events: auto;
  }
  .menu-home {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
  }
  .mark {
    width: 38px;
    height: 22px;
    background: var(--ink);
    border-radius: 4px 99px 99px 4px;
  }
  .menu-close {
    all: unset;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 4px;
  }
  .menu-close span {
    font-size: 22px;
    line-height: 1;
  }
  .menu-close:focus-visible,
  .menu-home:focus-visible,
  .col:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -6px;
  }
  .cols {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: calc(84px + env(safe-area-inset-top, 0px)) 20px calc(22px + env(safe-area-inset-bottom, 0px));
    border-right: 1px solid rgba(17, 17, 18, 0.18);
    overflow: hidden;
    min-width: 0;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }
  .col:last-child {
    border-right: 0;
  }
  .col:hover,
  .col:focus-visible,
  .col[aria-current='page'] {
    background: var(--c);
  }
  .letter {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: clamp(110px, 17vw, 260px);
    line-height: 0.78;
    align-self: center;
  }
  .col:nth-child(even) .letter {
    margin-top: auto;
  }
  .meta {
    display: grid;
    gap: 6px;
    margin-top: auto;
    padding-top: 24px;
  }
  .col:nth-child(even) .meta {
    margin-top: 0;
  }
  .name {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 18px;
  }
  .desc {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.35;
    max-width: 22ch;
    min-height: 2.7em;
  }
  .num {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 15px;
    margin-top: 18px;
  }
  .menu[open] .col {
    animation: drop 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .menu[open] .col:nth-child(2) { animation-delay: 0.05s; }
  .menu[open] .col:nth-child(3) { animation-delay: 0.1s; }
  .menu[open] .col:nth-child(4) { animation-delay: 0.15s; }
  @keyframes drop {
    from { transform: translateY(-40px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  @media (max-width: 760px) {
    .menu {
      overflow-y: auto;
    }
    .cols {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(88px, 1fr);
      padding-top: calc(64px + env(safe-area-inset-top, 0px));
      min-height: 100%;
    }
    .col {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 10px var(--gutter-r) 10px var(--gutter-l);
      border-right: 0;
      border-bottom: 1px solid rgba(17, 17, 18, 0.18);
    }
    .num { order: 0; margin: 0; width: 20px; }
    .letter { order: 1; font-size: 64px; margin: 0 !important; width: 56px; text-align: center; }
    .meta { order: 2; margin: 0 !important; padding-top: 0; }
    .desc { display: none; }
  }
</style>

<script>
  const menu = document.getElementById('site-menu') as HTMLDialogElement | null;
  if (menu) {
    document.querySelectorAll('[data-menu-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        menu.showModal();
        menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
      }),
    );
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  }
</script>
