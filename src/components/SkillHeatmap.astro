---
// Summary grid: categories × levels. Each chip links to the skill's detail row below.
// Picking a role tints each cell by how many of its skills matter for that role.
import {
  skillGroups,
  levels,
  skillSlug,
  allSkills,
  rolesFor,
  roleInfo,
  shortName,
  type Level,
  type RoleKey,
} from '../data/skills';

const levelKeys = Object.keys(levels) as Level[];
const roleKeys = Object.keys(roleInfo) as RoleKey[];
const total = allSkills.length;
const countAt = (l: Level) => allSkills.filter((s) => s.level === l).length;
---

<div class="heat" data-role="all">
  <div class="role-bar" role="group" aria-label="Show skills for a role">
    <button type="button" class="role-btn" data-pick="all" aria-pressed="true" style="--rc: var(--fg)">All skills</button>
    {
      roleKeys.map((k) => (
        <button type="button" class="role-btn" data-pick={k} aria-pressed="false" style={`--rc: ${roleInfo[k].color}`}>
          {roleInfo[k].name}
        </button>
      ))
    }
  </div>

  <p class="verdict" aria-live="polite">
    <span class="big" data-big>{total}</span>
    <span data-text>skills across six areas. Pick a role to see where I'm strongest for it.</span>
  </p>

  <div class="grid">
    <div class="corner" aria-hidden="true"></div>
    {
      levelKeys.map((l) => (
        <div class="col-head" style={`--lc: ${levels[l].color}`}>
          <span class="meter" aria-hidden="true">
            {[1, 2, 3].map((n) => <i class:list={{ on: n <= levels[l].rank }} />)}
          </span>
          <span class="ch-text">
            <span class="ch-name">{l}</span>
            <span class="ch-note">{levels[l].note} · {countAt(l)}</span>
          </span>
        </div>
      ))
    }

    {
      skillGroups.map((g) => (
        <>
          <div class="row-head">{g.title}</div>
          {levelKeys.map((l) => {
            const items = g.skills.filter((s) => s.level === l);
            return (
              <div class="cell" data-cell>
                <span class="cell-level">{l}</span>
                {items.length === 0 ? (
                  <span class="empty" aria-hidden="true">·</span>
                ) : (
                  items.map((s) => (
                    <a
                      class="chip"
                      href={`#${skillSlug(s.name)}`}
                      data-roles={rolesFor(s.name).join(' ')}
                      title={`${s.name}: ${l}`}
                    >
                      {shortName(s.name)}
                    </a>
                  ))
                )}
              </div>
            );
          })}
        </>
      ))
    }
  </div>
  <p class="hint">Darker cells hold more of the skills that role needs. Click any skill for where I used it.</p>
</div>

<style>
  .role-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .role-btn {
    all: unset;
    cursor: pointer;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: 12px;
    border: 2px solid var(--rc);
  }
  .role-btn[aria-pressed='true'] {
    background: var(--rc);
    color: var(--bg);
  }
  .role-btn:not([data-pick='all'])[aria-pressed='true'] {
    color: var(--ink);
  }
  .role-btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  .verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
    margin: 20px 0 18px;
    color: var(--muted);
    max-width: 70ch;
  }
  .big {
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--hc, var(--fg));
  }
  .verdict b {
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: 170px repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .col-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--lc);
    color: var(--ink);
  }
  .ch-text {
    display: grid;
  }
  .ch-name {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 15px;
    line-height: 1.1;
  }
  .ch-note {
    font-size: 12px;
  }
  .col-head .meter i {
    border-color: var(--ink);
  }
  .col-head .meter i.on {
    background: var(--ink);
  }
  .row-head {
    display: flex;
    align-items: center;
    padding: 12px 4px;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 22px;
    line-height: 1;
  }
  .cell {
    --heat: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 6px;
    padding: 12px;
    min-height: 64px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--hc, var(--fg)) calc(var(--heat) * 55%), var(--surface));
    transition: background-color 0.3s ease;
  }
  .cell-level {
    display: none;
  }
  .empty {
    color: var(--muted);
    opacity: 0.5;
  }
  .chip {
    display: inline-block;
    font-size: 13px;
    padding: 5px 11px;
    border-radius: 99px;
    border: 1.5px solid var(--line);
    background: var(--bg);
    text-decoration: none;
    transition: opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .chip:hover,
  .chip:focus-visible {
    border-color: var(--fg);
  }
  .heat:not([data-role='all']) .chip.hit {
    background: var(--hc);
    border-color: var(--hc);
    color: var(--ink);
    font-weight: 500;
  }
  .heat:not([data-role='all']) .chip.miss {
    opacity: 0.35;
  }
  .hint {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .meter {
    display: inline-flex;
    gap: 3px;
  }
  .meter i {
    display: block;
    width: 8px;
    height: 18px;
    border-radius: 3px;
    border: 1.5px solid currentColor;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .corner,
    .col-head {
      display: none;
    }
    .row-head {
      padding: 20px 0 4px;
    }
    .cell {
      min-height: 0;
      padding: 10px;
    }
    .cell-level {
      display: block;
      width: 100%;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .cell:has(.empty) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cell,
    .chip {
      transition: none;
    }
  }
</style>

<script>
  const ROLES: Record<string, { name: string; color: string }> = {
    swe: { name: 'Software Engineer', color: 'var(--pink)' },
    ai: { name: 'AI Engineer', color: 'var(--teal)' },
    data: { name: 'Data Scientist', color: 'var(--yellow)' },
  };
  document.querySelectorAll<HTMLElement>('.heat').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-pick]');
    const cells = root.querySelectorAll<HTMLElement>('[data-cell]');
    const chips = root.querySelectorAll<HTMLElement>('.chip');
    const big = root.querySelector('[data-big]')!;
    const text = root.querySelector('[data-text]')!;
    const total = chips.length;
    const defaultText = text.innerHTML;

    function pick(key: string) {
      root.dataset.role = key;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === key)));
      if (key === 'all') {
        root.style.removeProperty('--hc');
        cells.forEach((c) => c.style.setProperty('--heat', '0'));
        chips.forEach((c) => c.classList.remove('hit', 'miss'));
        big.textContent = String(total);
        text.innerHTML = defaultText;
        return;
      }
      const role = ROLES[key];
      root.style.setProperty('--hc', role.color);
      let hits = 0;
      let advanced = 0;
      const counts: number[] = [];
      cells.forEach((cell) => {
        let n = 0;
        cell.querySelectorAll<HTMLElement>('.chip').forEach((chip) => {
          const hit = (chip.dataset.roles ?? '').split(' ').includes(key);
          chip.classList.toggle('hit', hit);
          chip.classList.toggle('miss', !hit);
          if (hit) n++;
        });
        counts.push(n);
      });
      const max = Math.max(1, ...counts);
      cells.forEach((cell, i) => cell.style.setProperty('--heat', String(counts[i] / max)));
      chips.forEach((chip) => {
        if (chip.classList.contains('hit')) {
          hits++;
          if ((chip.getAttribute('title') ?? '').endsWith('Advanced')) advanced++;
        }
      });
      big.textContent = String(hits);
      const article = /^[AEIOU]/.test(role.name) ? 'an' : 'a';
      text.innerHTML = `of my ${total} skills apply to ${article} ${role.name} role, and <b>${advanced}</b> of those are advanced.`;
    }

    buttons.forEach((b) => b.addEventListener('click', () => pick(b.dataset.pick!)));
  });
</script>
