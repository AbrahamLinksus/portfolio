---
// A drum kit seen from above. Each drum or cymbal carries one fact.
interface Piece {
  value: string;
  label: string;
}
interface Props {
  kick: Piece;
  snare: Piece;
  tom1: Piece;
  tom2: Piece;
  floor: Piece;
  hihat: Piece;
  crash: Piece;
  ride: Piece;
}
const p = Astro.props;
const drums = [
  { k: 'snare', cx: 212, cy: 300, r: 64, d: p.snare },
  { k: 'tom1', cx: 296, cy: 176, r: 54, d: p.tom1 },
  { k: 'tom2', cx: 428, cy: 176, r: 54, d: p.tom2 },
  { k: 'floor', cx: 552, cy: 308, r: 74, d: p.floor },
];
const cymbals = [
  { k: 'hihat', cx: 96, cy: 222, r: 64, d: p.hihat },
  { k: 'crash', cx: 168, cy: 82, r: 72, d: p.crash },
  { k: 'ride', cx: 600, cy: 128, r: 86, d: p.ride },
];
const all = [...drums, ...cymbals];
// Shrink long words so they always fit inside their drum or cymbal.
const fit = (text: string, r: number) => Math.min(26, (r * 1.55) / (text.length * 0.5));
---

<svg class="kit" viewBox="0 0 720 470" role="img" aria-label={`Drum kit from above: ${all.map((x) => `${x.d.value} ${x.d.label}`).join(', ')}, ${p.kick.value} ${p.kick.label}`}>
  <rect x="0" y="0" width="720" height="470" rx="18" class="rug"></rect>
  <circle cx="362" cy="468" r="44" class="throne"></circle>
  {
    cymbals.map((c) => (
      <g class="cymbal">
        <circle cx={c.cx} cy={c.cy} r={c.r} class="disc" />
        {[0.82, 0.64, 0.46].map((f) => (
          <circle cx={c.cx} cy={c.cy} r={c.r * f} class="groove" />
        ))}
        <circle cx={c.cx} cy={c.cy} r={c.r * 0.2} class="bell" />
        <text class="v" x={c.cx} y={c.cy - 4} text-anchor="middle" style={`--fs: ${fit(c.d.value, c.r)}px`}>{c.d.value}</text>
        <text class="l" x={c.cx} y={c.cy + 16} text-anchor="middle">{c.d.label}</text>
      </g>
    ))
  }
  <g class="kick">
    <rect x="284" y="254" width="156" height="150" rx="14" class="shell"></rect>
    <rect x="300" y="270" width="124" height="118" rx="8" class="head"></rect>
    <rect x="350" y="404" width="24" height="34" rx="5" class="pedal"></rect>
    <text class="v big" x="362" y="338" text-anchor="middle">{p.kick.value}</text>
    <text class="l" x="362" y="362" text-anchor="middle">{p.kick.label}</text>
  </g>
  {
    drums.map((d) => (
      <g class="drum">
        <circle cx={d.cx} cy={d.cy} r={d.r} class="rim" />
        <circle cx={d.cx} cy={d.cy} r={d.r - 9} class="head" />
        {Array.from({ length: 8 }, (_, i) => {
          const a = (i / 8) * Math.PI * 2;
          return <circle cx={d.cx + Math.cos(a) * (d.r - 4)} cy={d.cy + Math.sin(a) * (d.r - 4)} r="3" class="lug" />;
        })}
        <text class="v" x={d.cx} y={d.cy + 2} text-anchor="middle" style={`--fs: ${fit(d.d.value, d.r)}px`}>{d.d.value}</text>
        <text class="l" x={d.cx} y={d.cy + 22} text-anchor="middle">{d.d.label}</text>
      </g>
    ))
  }
</svg>

<style>
  .kit {
    display: block;
    width: 100%;
    height: auto;
  }
  .rug {
    fill: #2a1218;
  }
  .throne {
    fill: #1a0b0f;
    stroke: #5a2433;
    stroke-width: 2;
  }
  .cymbal .disc {
    fill: #d9a92a;
  }
  .cymbal .groove {
    fill: none;
    stroke: #f6d23a;
    stroke-width: 1.4;
    opacity: 0.7;
  }
  .cymbal .bell {
    fill: #f6d23a;
  }
  .drum .rim,
  .kick .shell {
    fill: #f4507a;
  }
  .drum .head,
  .kick .head {
    fill: #f2ece4;
  }
  .drum .lug {
    fill: #8f1d3d;
  }
  .kick .pedal {
    fill: #111112;
  }
  .v {
    font-family: var(--font-display);
    font-size: var(--fs, 26px);
    fill: #111112;
  }
  .v.big {
    font-size: 64px;
  }
  .l {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    fill: #5e2a39;
  }
  .cymbal .l {
    fill: #3d2c06;
  }
  @media (max-width: 600px) {
    .v {
      font-size: calc(var(--fs, 26px) * 1.3);
    }
    .v.big {
      font-size: 72px;
    }
    .l {
      font-size: 15px;
      letter-spacing: 0.04em;
    }
  }
</style>
