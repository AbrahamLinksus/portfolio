---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { intro, chain, highlights, activities } from '../data/about';
import { getProjects, colorVar } from '../lib/projects';

// Second photo of Jake, beside the story. Leave empty to show the placeholder frame.
const photo = '/images/about/portrait.webp';

const projects = await getProjects();
const built = chain.map((c, i) => {
  const p = projects.find((x) => x.id === c.project);
  if (!p) throw new Error(`About: unknown project "${c.project}"`);
  // The title already names the project, so drop "Name, " from the start of the description.
  const lead = `${p.data.title}, `;
  const rest = c.built.toLowerCase().startsWith(lead.toLowerCase()) ? c.built.slice(lead.length) : c.built;
  return { ...c, p, n: String(i + 1).padStart(2, '0'), what: rest.charAt(0).toUpperCase() + rest.slice(1) };
});
const research = highlights.find((h) => h.kind.startsWith('Research'));
---

<BaseLayout title="About" description="Jake Roberts: Computer Science student at SRM IST (class of 2027), building tools for problems he runs into himself.">
  <PageIntro number="01" title="About" lede="All-rounder, kind of." />

  <section class="container profile">
    <div class="photo-col">
      <figure class="portrait">
        {
          photo ? (
            <img src={photo} alt="Jake Roberts" width="640" height="800" />
          ) : (
            <div class="ph" role="img" aria-label="Photo coming soon">
              <span>Your photo</span>
            </div>
          )
        }
      </figure>
    </div>

    <div class="story">
      <div class="intro">
        {intro.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>

      <section aria-labelledby="path-title">
        <div class="sec-head">
          <h2 id="path-title" class="display sec-title">One problem led to the next</h2>
          <span class="label">What I've built, in order</span>
        </div>

        <ol class="timeline">
          {
            built.map((b) => (
              <li class="step" style={`--c: ${colorVar(b.p.data.color)}`}>
                <span class="when">
                  Project {b.n} · {b.p.data.year}
                </span>
                <h3 class="what">
                  <a href={`/projects/${b.p.id}`}>{b.p.data.title}</a>
                </h3>
                <p class="problem">{b.problem}</p>
                <p class="detail">{b.what}</p>
                <a class="go" href={`/projects/${b.p.id}`} aria-label={`Read the ${b.p.data.title} case study`}>
                  Read the case study →
                </a>
              </li>
            ))
          }
          {
            research && (
              <li class="step" style={`--c: ${research.color}`}>
                <span class="when">{research.kind}</span>
                <h3 class="what">{research.title}</h3>
                <p class="detail">{research.line}</p>
                {research.link && (
                  <a class="go" href={research.link.href}>
                    {research.link.label} →
                  </a>
                )}
              </li>
            )
          }
        </ol>
      </section>

      <section aria-labelledby="off-title">
        <div class="sec-head">
          <h2 id="off-title" class="display sec-title">Off the keyboard</h2>
          <span class="label">Tap a ticket to see it</span>
        </div>
        <div class="board">
          <ul class="tickets">
            {
              activities.map((a, i) => (
                <li class="ticket-wrap" style={`--c: ${a.color}; --r: ${[-2.2, 1.6, 1.2, -1.6][i] ?? 0}deg`}>
                  <button
                    type="button"
                    class="ticket"
                    data-ticket
                    aria-pressed="false"
                    aria-label={`${a.kind}: ${a.title}. Show photo`}
                  >
                    <span class="face front" aria-hidden="true">
                      <span class="t-main">
                        <span class="t-kind">
                          {a.kind} · No. {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="t-title display">{a.title}</span>
                        <span class="t-line">{a.line}</span>
                      </span>
                      <span class="t-stub">Admit one</span>
                    </span>
                    <span class="face back" aria-hidden="true">
                      {a.photo ? (
                        <img src={a.photo} alt="" width="960" height="640" loading="lazy" />
                      ) : (
                        <span class="t-ph">Photo coming soon</span>
                      )}
                      <span class="t-cap">
                        {a.kind} · {a.caption}
                      </span>
                    </span>
                  </button>
                  <p class="sr-only">{a.kind}: {a.title}. {a.line}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  /* Desktop: photo on the left stays in view; the story reads down one column on the right. */
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.6fr);
    gap: 64px;
    align-items: start;
  }
  .photo-col {
    position: sticky;
    top: 32px;
  }
  .portrait {
    margin: 0;
    padding: 12px;
    border-radius: 22px;
    background: var(--panel);
    transform: rotate(-2deg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  .portrait img,
  .ph {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    object-fit: cover;
  }
  .ph {
    display: grid;
    place-items: center;
    background-color: #e4ddd2;
    background-image:
      linear-gradient(var(--panel-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--panel-grid) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .ph span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5e5a55;
  }

  .story {
    display: grid;
    gap: 40px;
    min-width: 0;
  }
  .intro {
    display: grid;
    gap: 18px;
  }
  .story > section {
    margin-top: 16px;
  }
  .intro p {
    margin: 0;
    max-width: 62ch;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }
  .intro p.lead {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.35;
    color: var(--fg);
  }
  .intro p:last-child {
    color: var(--fg);
    font-weight: 500;
  }




  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 8px;
  }
  .sec-title {
    font-size: clamp(32px, 4vw, 48px);
  }

  /* One vertical timeline: coloured dots on a thin line, no boxes. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 24px 0 24px 34px;
    border-bottom: 1px solid var(--line);
  }
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 30px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 50px;
    bottom: -30px;
    width: 2px;
    background: var(--line);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .what {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .what a {
    text-decoration: none;
  }
  .what a:hover {
    color: var(--c);
  }
  .problem {
    margin: 2px 0 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }
  .detail {
    margin: 0;
    max-width: 60ch;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--muted);
  }
  .go {
    justify-self: start;
    margin-top: 4px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1.5px solid var(--c);
  }

  /* Off the keyboard: four gig-style tickets pinned to the cream grid board. */
  .board {
    margin-top: 18px;
    padding: 34px 30px;
    border-radius: 26px;
    background-color: var(--panel);
    background-image:
      linear-gradient(var(--panel-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--panel-grid) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .tickets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 26px;
  }
  .ticket-wrap {
    position: relative;
    perspective: 1200px;
    transform: rotate(var(--r));
    filter: drop-shadow(0 4px 0 rgba(0, 0, 0, 0.22));
    transition: transform 0.2s ease;
  }
  .ticket-wrap:hover {
    transform: rotate(0deg) translateY(-3px);
  }
  /* Each ticket is a button that flips over to show a photo on its back. */
  .ticket {
    --stub: 54px;
    all: unset;
    pointer-events: auto;
    box-sizing: border-box;
    display: grid;
    width: 100%;
    height: 100%;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ticket[aria-pressed='true'] {
    transform: rotateY(180deg);
  }
  .ticket:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 6px;
    border-radius: 16px;
  }
  .face {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--stub);
    min-height: 210px;
    border-radius: 14px;
    background: var(--c);
    color: var(--ink);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    /* Punched notches where the stub tears off. */
    -webkit-mask:
      radial-gradient(circle 9px at calc(100% - var(--stub)) 0, transparent 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle 9px at calc(100% - var(--stub)) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
    mask:
      radial-gradient(circle 9px at calc(100% - var(--stub)) 0, transparent 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle 9px at calc(100% - var(--stub)) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
  }
  .back {
    transform: rotateY(180deg);
    grid-template-columns: 1fr;
    position: relative;
    overflow: hidden;
    background: #1a1918;
  }
  .back img,
  .t-ph {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .t-ph {
    display: grid;
    place-items: center;
    background-color: color-mix(in srgb, var(--c) 35%, #e4ddd2);
    background-image:
      linear-gradient(rgba(17, 17, 18, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 17, 18, 0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .t-cap {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 5px 10px;
    border-radius: 99px;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .t-main {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 18px 18px 20px;
  }
  .t-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .t-kind,
  .t-title,
  .t-line {
    display: block;
  }
  .t-title {
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 0.95;
  }
  .t-line {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .t-stub {
    display: grid;
    place-items: center;
    border-left: 2px dashed rgba(17, 17, 18, 0.35);
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket-wrap,
    .ticket {
      transition: none;
    }
  }
  @media (max-width: 860px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .photo-col {
      position: static;
      width: min(280px, 72%);
    }
    .portrait {
      transform: rotate(-1.5deg);
    }
  }
  @media (max-width: 640px) {
    .board {
      padding: 22px 16px;
    }
    .tickets {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .ticket {
      --stub: 44px;
    }
    .face {
      min-height: 190px;
    }
    .story {
      gap: 32px;
    }
    .intro p {
      font-size: 17px;
    }

    .sec-title {
      font-size: 34px;
    }
    .step {
      padding: 20px 0 20px 28px;
    }
    .step::before {
      top: 25px;
      width: 12px;
      height: 12px;
    }
    .step:not(:last-child)::after {
      left: 5px;
      top: 43px;
      bottom: -25px;
    }
    .what {
      font-size: 19px;
    }
    .problem {
      font-size: 16px;
    }
  }
</style>

<script>
  // Tap a ticket to flip it and see the photo; opening another flips the first one back.
  const tickets = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ticket]'));
  const set = (t: HTMLButtonElement, on: boolean) => {
    t.setAttribute('aria-pressed', String(on));
    const label = t.getAttribute('aria-label') ?? '';
    t.setAttribute('aria-label', label.replace(/\. (Show|Hide) photo$/, on ? '. Hide photo' : '. Show photo'));
  };
  tickets.forEach((t) =>
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-pressed') === 'true';
      tickets.forEach((x) => set(x, false));
      if (!open) set(t, true);
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') tickets.forEach((x) => set(x, false));
  });
</script>
