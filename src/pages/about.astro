---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { origin, timeline, kinds, type Kind } from '../data/about';
import { site } from '../site';

const kindKeys = Object.keys(kinds) as Kind[];
---

<BaseLayout title="About" description="Jake Roberts: from a first Python circle at fifteen to backend systems and AI engineering.">
  <PageIntro number="01" title="About" lede={`I'm ${site.name}. Software engineer in the making, drummer, badminton regular.`} />

  <section class="container origin">
    <p class="remember display">{origin.remember}</p>
    <div class="story">
      <span class="label">How it started</span>
      {origin.story.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="container history" aria-labelledby="history-title">
    <div class="h-head">
      <h2 id="history-title" class="display h-title">The timeline</h2>
      <ul class="legend" aria-label="Legend">
        {
          kindKeys.map((k) => (
            <li style={`--c: ${kinds[k].color}`}>
              <span class="ld" aria-hidden="true" />
              {kinds[k].label}
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="line">
      {
        timeline.map((m, i) => {
          const showYear = i === 0 || timeline[i - 1].year !== m.year;
          return (
            <li class:list={['moment', m.kind, { future: m.future, first: showYear }]} style={`--c: ${kinds[m.kind].color}`}>
              <span class="year display" aria-hidden={!showYear}>
                {showYear ? m.year : ''}
                {showYear && m.approx && <span class="approx">approx.</span>}
              </span>
              <span class="node" aria-hidden="true" />
              <div class="card">
                <span class="kind">{kinds[m.kind].label}{!showYear && <span class="sr"> · {m.year}</span>}</span>
                <h3 class="m-title">{m.title}</h3>
                {m.line && <p class="m-line">{m.line}</p>}
                {m.link && (
                  <a class="m-link" href={m.link.href}>
                    {m.link.label} →
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .origin {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 48px;
    align-items: start;
    padding-bottom: 24px;
  }
  .remember {
    margin: 0;
    font-size: clamp(56px, 8vw, 112px);
    line-height: 0.9;
    color: var(--teal);
    text-wrap: balance;
  }
  .story {
    display: grid;
    gap: 14px;
  }
  .story p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    max-width: 58ch;
  }

  .history {
    padding-top: 72px;
  }
  .h-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 28px;
  }
  .h-title {
    font-size: clamp(40px, 6vw, 64px);
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ld {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c);
  }

  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .moment {
    display: grid;
    grid-template-columns: 170px 28px minmax(0, 1fr);
    gap: 0 20px;
    position: relative;
  }
  /* The spine runs through the node column. */
  .moment::before {
    content: '';
    position: absolute;
    left: calc(170px + 20px + 13px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--line);
  }
  .moment.future::before {
    background: repeating-linear-gradient(var(--line) 0 6px, transparent 6px 12px);
  }
  .moment:last-child::before {
    bottom: calc(100% - 30px);
  }
  .year {
    text-align: right;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    padding-top: 10px;
    color: var(--fg);
  }
  .approx {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: lowercase;
    margin-top: 4px;
  }
  .node {
    position: relative;
    z-index: 1;
    width: 28px;
    height: 28px;
    margin-top: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--c);
  }
  .moment.first .node {
    background: var(--c);
  }
  .future .node {
    border-style: dashed;
    background: var(--bg) !important;
  }
  .card {
    display: grid;
    gap: 6px;
    padding: 14px 0 34px;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .m-title {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.05;
  }
  .m-line {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    max-width: 60ch;
  }
  .m-link {
    justify-self: start;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1.5px solid var(--c);
    color: var(--fg);
  }
  .future .m-title,
  .future .m-line {
    opacity: 0.75;
  }

  @media (max-width: 860px) {
    .origin {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .moment {
      grid-template-columns: 22px minmax(0, 1fr);
      gap: 0 14px;
    }
    .moment::before {
      left: 10px;
    }
    .year {
      grid-column: 2;
      grid-row: 1;
      text-align: left;
      font-size: 32px;
      padding-top: 6px;
    }
    .moment:not(.first) .year {
      display: none;
    }
    .approx {
      display: inline;
      margin-left: 8px;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
      width: 22px;
      height: 22px;
      margin-top: 12px;
    }
    .card {
      grid-column: 2;
      padding-top: 4px;
    }
    .moment:not(.first) .node {
      grid-row: 2;
      margin-top: 6px;
    }
    .moment:not(.first) .card {
      grid-row: 2;
    }
  }
</style>
