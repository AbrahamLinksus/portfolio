---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { intro, chain, highlights } from '../data/about';
import { getProjects, colorVar } from '../lib/projects';

// Second photo of Jake, beside the intro. Leave empty to show the placeholder frame.
const photo = '';

const projects = await getProjects();
const links = chain.map((c, i) => {
  const p = projects.find((x) => x.id === c.project);
  if (!p) throw new Error(`About: unknown project "${c.project}"`);
  return { ...c, p, n: String(i + 1).padStart(2, '0') };
});
---

<BaseLayout title="About" description="Jake Roberts: Computer Science student at SRM IST (class of 2027), building tools for problems he runs into himself.">
  <PageIntro number="01" title="About" lede="All-rounder, kind of." />

  <section class="container intro-row">
    <div class="intro">
      {intro.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
    </div>
    <figure class="portrait">
      {
        photo ? (
          <img src={photo} alt="Jake Roberts" width="800" height="1000" loading="lazy" />
        ) : (
          <div class="ph" role="img" aria-label="Photo coming soon">
            <span>Your photo</span>
          </div>
        )
      }
    </figure>
  </section>

  <section class="container chain-wrap" aria-labelledby="chain-title">
    <div class="sec-head">
      <h2 id="chain-title" class="display sec-title">One problem led to the next</h2>
      <span class="label">Four projects, in the order I built them</span>
    </div>
    <ol class="chain">
      {
        links.map((l) => (
          <li class="link" style={`--c: ${colorVar(l.p.data.color)}`}>
            <a class="card" href={`/projects/${l.p.id}`}>
              <span class="top">
                <span class="n">{l.n}</span>
                <span class="letter" aria-hidden="true">{l.p.data.letter}</span>
              </span>
              <span class="problem-label">The problem</span>
              <span class="problem">{l.problem}</span>
              <span class="built-label">So I built</span>
              <span class="built">{l.built}</span>
              <span class="go">Read the case study →</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container more" aria-label="Research and experience">
    {
      highlights.map((h) => (
        <article class="hl" style={`--c: ${h.color}`}>
          <span class="hk">{h.kind}</span>
          <h3 class="ht display">{h.title}</h3>
          <p class="hline">{h.line}</p>
          {h.link && (
            <a class="hlink" href={h.link.href}>
              {h.link.label} →
            </a>
          )}
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .intro-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr);
    gap: 56px;
    align-items: start;
  }
  .intro {
    display: grid;
    gap: 18px;
  }
  /* The photo sits in a cream frame, slightly tilted, like a print pinned to the page. */
  .portrait {
    margin: 0;
    padding: 12px;
    border-radius: 22px;
    background: var(--panel);
    transform: rotate(2.5deg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  .portrait img,
  .ph {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .ph {
    display: grid;
    place-items: center;
    background-color: #e4ddd2;
    background-image:
      linear-gradient(var(--panel-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--panel-grid) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .ph span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5e5a55;
  }
  .intro p {
    margin: 0;
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }
  .intro p.lead {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.35;
    color: var(--fg);
  }
  .intro p:last-child {
    color: var(--fg);
    font-weight: 500;
  }

  .chain-wrap {
    padding-top: 64px;
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 22px;
  }
  .sec-title {
    font-size: clamp(36px, 5vw, 60px);
  }
  .chain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 34px;
  }
  .link {
    position: relative;
    display: flex;
  }
  /* Arrow from each card to the next. */
  .link:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -27px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--muted);
  }
  .card {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 20px;
    border-radius: 18px;
    border: 2px solid var(--c);
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }
  .card:hover,
  .card:focus-visible {
    background: var(--c);
    color: var(--ink);
    transform: translateY(-3px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 4px;
  }
  .n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .letter {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 30px;
    transform: rotate(-6deg);
  }
  .card:hover .letter,
  .card:focus-visible .letter {
    background: var(--ink);
    color: var(--c);
  }
  .problem-label,
  .built-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .card:hover .problem-label,
  .card:hover .built-label,
  .card:hover .n,
  .card:focus-visible .problem-label,
  .card:focus-visible .built-label,
  .card:focus-visible .n {
    color: var(--ink);
  }
  .built-label {
    margin-top: 8px;
  }
  .problem {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 17px;
    line-height: 1.15;
  }
  .built {
    font-size: 14.5px;
    line-height: 1.5;
  }
  .go {
    margin-top: 10px;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .more {
    padding-top: 56px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .hl {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 5px solid var(--c);
  }
  .hk {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .ht {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 44px);
  }
  .hline {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
    max-width: 52ch;
  }
  .hlink {
    justify-self: start;
    margin-top: 4px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1.5px solid var(--c);
  }

  @media (max-width: 1000px) {
    .chain {
      grid-template-columns: 1fr 1fr;
    }
    .link:nth-child(2)::after {
      content: '↓';
      right: auto;
      left: -17px;
      top: auto;
      bottom: -30px;
      transform: none;
    }
  }
  /* Phones: a compact timeline instead of boxed cards. */
  @media (max-width: 860px) {
    .intro-row {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .portrait {
      order: -1;
      width: min(280px, 72%);
    }
  }
  @media (max-width: 640px) {
    .chain {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .link {
      padding: 0 0 26px 30px;
    }
    .link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 4px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--c);
    }
    .link:not(:last-child)::after {
      content: '';
      left: 6px;
      right: auto;
      top: 22px;
      bottom: 0;
      width: 2px;
      transform: none;
      background: var(--line);
    }
    .card {
      padding: 0;
      border: 0;
      border-radius: 0;
      gap: 4px;
    }
    .card:hover,
    .card:focus-visible {
      background: none;
      color: inherit;
      transform: none;
    }
    .card:hover .problem-label,
    .card:hover .built-label,
    .card:focus-visible .problem-label,
    .card:focus-visible .built-label {
      color: var(--c);
    }
    .top {
      display: none;
    }
    .problem-label {
      display: none;
    }
    .problem {
      font-size: 18px;
    }
    .built-label {
      margin-top: 6px;
    }
    .built {
      color: var(--muted);
    }
    .go {
      margin-top: 4px;
      color: var(--c);
      font-size: 12px;
    }
    .more {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
