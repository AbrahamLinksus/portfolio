---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SkillCortex from '../components/SkillCortex.astro';
import { skillGroups, levels, skillSlug, allSkills, certifications, type Level } from '../data/skills';
import { getProjects, colorVar } from '../lib/projects';

const projects = await getProjects();
const usedIn = (name: string) => projects.filter((p) => p.data.skills.includes(name));
const learning = allSkills.filter((s) => s.level === 'Learning');
---

<BaseLayout
  title="Skills"
  description="What Jake Roberts has learned so far, with levels and the projects where each skill was used."
>
  <PageIntro
    number="03"
    title="Skills"
    lede="What I can build with, sorted by how strong I am in each. Each skill links to the projects where I actually used it."
  />

  <section class="container">
    <SkillCortex />
    <a class="scroll-cue" href="#details">The full list: every skill, its level, and where I used it <span aria-hidden="true">↓</span></a>
    <div id="details"></div>
    <ul class="level-key" aria-label="Level key">
      {
        (Object.keys(levels) as Level[]).map((k) => (
          <li style={`--lc: ${levels[k].color}`}>
            <span class="meter" aria-hidden="true">
              {[1, 2, 3].map((n) => <i class:list={{ on: n <= levels[k].rank }} />)}
            </span>
            {k}
          </li>
        ))
      }
    </ul>

    {
      skillGroups.map((g, gi) => (
        <details class="group" data-collapse open>
          <summary class="ghead">
            <h2 id={`g-${gi}`} class="display gtitle">{g.title}</h2>
            <p class="gpun">{g.pun}</p>
            <span class="gcount" aria-hidden="true">{g.skills.length} skills</span>
          </summary>
          <ul class="rows">
            {g.skills.map((s) => {
              const lv = levels[s.level];
              const used = usedIn(s.name);
              return (
                <li class="row" id={skillSlug(s.name)} style={`--lc: ${lv.color}`}>
                  <span class="sname">{s.name}</span>
                  <span class="level">
                    <span class="meter" aria-hidden="true">
                      {[1, 2, 3].map((n) => <i class:list={{ on: n <= lv.rank }} />)}
                    </span>
                    <span class="lt">{s.level}</span>
                  </span>
                  <span class="used">
                    {used.map((p) => (
                        <a
                          class="pchip"
                          href={`/projects/${p.id}`}
                          style={`--pc: ${colorVar(p.data.color)}`}
                          title={p.data.title}
                        >
                          <span class="pl" aria-hidden="true">{p.data.letter}</span>
                          <span class="pn">{p.data.title}</span>
                        </a>
                    ))}
                    {s.from?.map((f) => <span class="src">{f}</span>)}
                  </span>
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }

    <details class="group learning" id="learning" data-collapse open>
      <summary class="ghead">
        <h2 id="learning-title" class="display gtitle">Learning log ’26</h2>
        <p class="gpun">Currently compiling. Expect breaking changes.</p>
        <span class="gcount" aria-hidden="true">{learning.length} skills</span>
      </summary>
      <ul class="now-learning">
        {
          learning.map((s) => (
            <li>
              <a href={`#${skillSlug(s.name)}`}>{s.name}</a>
            </li>
          ))
        }
      </ul>
    </details>

    <details class="group" id="certifications" data-collapse open>
      <summary class="ghead">
        <h2 id="certs-title" class="display gtitle">Certifications</h2>
        <p class="gpun">Proof I read the docs. Sometimes.</p>
        <span class="gcount" aria-hidden="true">{certifications.length} certificates</span>
      </summary>
      <ul class="certs">
        {
          certifications.map((c) => (
            <li>
              <span class="cname">{c.name}</span>
              <span class="cissuer">{c.issuer}</span>
            </li>
          ))
        }
      </ul>
    </details>
  </section>
</BaseLayout>

<style>
  /* Groups are <details>: always open on desktop, tap-to-open rows on phones. */
  .ghead {
    list-style: none;
  }
  .ghead::-webkit-details-marker {
    display: none;
  }
  .gcount {
    display: none;
  }
  @media (min-width: 641px) {
    .ghead {
      pointer-events: none;
    }
  }
  @media (max-width: 640px) {
    .ghead {
      cursor: pointer;
      position: relative;
      padding-right: 34px;
    }
    .ghead::after {
      content: '+';
      position: absolute;
      right: 0;
      bottom: 14px;
      font-family: var(--font-mono);
      font-size: 22px;
      line-height: 1;
    }
    .group[open] > .ghead::after {
      content: '−';
    }
    .group {
      padding-top: 16px;
    }
    .gtitle {
      font-size: 34px;
    }
    .group[open] .rows,
    .group[open] .now-learning,
    .group[open] .certs {
      margin-top: 8px;
    }
    .gpun {
      display: none;
    }
    .gcount {
      display: inline;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
  .scroll-cue {
    display: inline-flex;
    gap: 8px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .scroll-cue:hover {
    color: var(--fg);
  }
  #details {
    scroll-margin-top: 0;
  }

  .meter {
    display: inline-flex;
    gap: 4px;
  }
  .meter i {
    display: block;
    width: 10px;
    height: 22px;
    border-radius: 3px;
    border: 1.5px solid var(--lc);
  }
  .meter i.on {
    background: var(--lc);
  }

  .group {
    padding-top: 64px;
    scroll-behavior: smooth;
    scroll-margin-top: 24px;
  }
  .ghead {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
  }
  .gtitle {
    font-size: clamp(40px, 6vw, 64px);
  }
  .gpun {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) 190px minmax(0, 1.6fr);
    align-items: center;
    gap: 16px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 24px;
    transition: background-color 0.3s ease;
  }
  .row:target {
    background: color-mix(in srgb, var(--lc) 18%, transparent);
    border-radius: 10px;
  }
  .sname {
    font-size: 17px;
    font-weight: 500;
  }
  .level {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .level .meter i {
    width: 8px;
    height: 16px;
  }
  .lt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .used {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pchip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 10px 3px 3px;
    border-radius: 99px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 12.5px;
  }
  .pchip:hover {
    background: var(--pc);
    border-color: var(--pc);
    color: var(--ink);
  }
  .pl {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pc);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 13px;
  }
  .src {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }

  .now-learning {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .now-learning a {
    display: inline-block;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 18px;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--yellow);
    color: var(--ink);
    text-decoration: none;
    transform: rotate(-3deg);
  }
  .now-learning li:nth-child(even) a {
    background: var(--teal);
    transform: rotate(3deg);
  }
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .certs li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
  }
  .cname {
    font-size: 16px;
  }
  .cissuer {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Key for the level bars; only shown on phones, where rows drop the level word. */
  .level-key {
    display: none;
  }
  @media (max-width: 640px) {
    .level-key {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      list-style: none;
      margin: 18px 0 0;
      padding: 0;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .level-key li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .level-key .meter i {
      width: 5px;
      height: 11px;
      border-width: 1px;
      border-radius: 2px;
    }
    /* Compact two-line rows: name + bars, then project dots and sources. */
    .row {
      grid-template-columns: minmax(0, 1fr) auto !important;
      gap: 6px 12px !important;
      padding: 11px 2px !important;
    }
    .sname {
      font-size: 15px;
      line-height: 1.3;
    }
    .lt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .level .meter {
      gap: 3px;
    }
    .level .meter i {
      width: 6px;
      height: 13px;
      border-width: 1px;
      border-radius: 2px;
    }
    .used {
      gap: 4px 8px;
      align-items: center;
    }
    .used:empty {
      display: none;
    }
    .pchip {
      padding: 0 !important;
      border: 0;
    }
    .pl {
      width: 20px;
      height: 20px;
      font-size: 11.5px;
    }
    .src {
      padding: 0;
      border: 0;
      font-size: 11px;
    }
    .src::before {
      content: '·\00a0';
    }
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 10px 12px;
    }
    .used {
      grid-column: 1 / -1;
    }
    .pn {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .pchip {
      padding-right: 3px;
    }
  }
</style>

<script>
  // Phones start with every group closed; desktop keeps them open and fixed.
  const phone = window.matchMedia('(max-width: 640px)');
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-collapse]'));
  const sync = () => groups.forEach((d) => (d.open = !phone.matches));
  sync();
  phone.addEventListener('change', sync);
  groups.forEach((d) => d.addEventListener('toggle', () => !phone.matches && !d.open && (d.open = true)));
  // A link to a skill (or a group) opens the group that holds it.
  const reveal = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    const d = el ? (el.closest('details') as HTMLDetailsElement | null) : null;
    if (d && !d.open) {
      d.open = true;
      el.scrollIntoView();
    }
  };
  reveal();
  window.addEventListener('hashchange', reveal);
</script>
