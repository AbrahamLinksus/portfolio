---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SkillCortex from '../components/SkillCortex.astro';
import { skillGroups, levels, skillSlug, type Level } from '../data/skills';
import { getProjects, colorVar } from '../lib/projects';

const projects = await getProjects();
const usedIn = (name: string) => projects.filter((p) => p.data.skills.includes(name));
---

<BaseLayout
  title="Skills"
  description="What Jake Roberts has learned so far, with levels and the projects where each skill was used."
>
  <PageIntro
    number="04"
    title="Skills"
    lede="Sorted by strength. The top of each list is where I'm at my best. Each skill links to the projects where I actually used it."
  />

  <section class="container">
    <SkillCortex />
    <a class="scroll-cue" href="#details">The full list: every skill, its level, and where I used it <span aria-hidden="true">↓</span></a>
    <div id="details"></div>
    <ul class="level-key" aria-label="Level key">
      {
        (Object.keys(levels) as Level[]).map((k) => (
          <li style={`--lc: ${levels[k].color}`}>
            <span class="meter" aria-hidden="true">
              {[1, 2, 3].map((n) => <i class:list={{ on: n <= levels[k].rank }} />)}
            </span>
            {k}
          </li>
        ))
      }
    </ul>

    {
      skillGroups.map((g, gi) => (
        <details class="group" data-collapse>
          <summary class="ghead">
            <h2 id={`g-${gi}`} class="display gtitle">{g.title}</h2>
            <p class="gpun">{g.pun}</p>
            <span class="gcount" aria-hidden="true">{g.skills.length} skills</span>
          </summary>
          <ul class="rows">
            {g.skills.map((s) => {
              const lv = levels[s.level];
              const used = usedIn(s.name);
              return (
                <li class="row" id={skillSlug(s.name)} style={`--lc: ${lv.color}`}>
                  <span class="sname">{s.name}</span>
                  <span class="level">
                    <span class="meter" aria-hidden="true">
                      {[1, 2, 3].map((n) => <i class:list={{ on: n <= lv.rank }} />)}
                    </span>
                    <span class="lt">{s.level}</span>
                  </span>
                  <span class="used">
                    {used.map((p) => (
                        <a
                          class="pchip"
                          href={`/projects/${p.id}`}
                          style={`--pc: ${colorVar(p.data.color)}`}
                          title={p.data.title}
                        >
                          <span class="pl" aria-hidden="true">{p.data.letter}</span>
                          <span class="pn">{p.data.title}</span>
                        </a>
                    ))}
                    {s.from?.map((f) => <span class="src">{f}</span>)}
                  </span>
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }

  </section>
</BaseLayout>

<style>
  /* Groups are <details>: closed rows that open on click or tap, on every screen size. */
  .ghead {
    list-style: none;
  }
  .ghead::-webkit-details-marker {
    display: none;
  }
  .scroll-cue {
    display: inline-flex;
    gap: 8px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }
  .scroll-cue:hover {
    color: var(--fg);
  }
  #details {
    scroll-margin-top: 0;
  }

  .meter {
    display: inline-flex;
    gap: 4px;
  }
  .meter i {
    display: block;
    width: 10px;
    height: 22px;
    border-radius: 3px;
    border: 1.5px solid var(--lc);
  }
  .meter i.on {
    background: var(--lc);
  }

  .group {
    padding-top: 64px;
    scroll-behavior: smooth;
    scroll-margin-top: 24px;
  }
  .ghead {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
  }
  .gtitle {
    font-size: clamp(40px, 6vw, 64px);
  }
  .gpun {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) 190px minmax(0, 1.6fr);
    align-items: center;
    gap: 16px;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 24px;
    transition: background-color 0.3s ease;
  }
  .row:target {
    background: color-mix(in srgb, var(--lc) 18%, transparent);
    border-radius: 10px;
  }
  .sname {
    font-size: 17px;
    font-weight: 500;
  }
  .level {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .level .meter i {
    width: 8px;
    height: 16px;
  }
  .lt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .used {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pchip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 10px 3px 3px;
    border-radius: 99px;
    border: 1px solid var(--line);
    text-decoration: none;
    font-size: 12.5px;
  }
  .pchip:hover {
    background: var(--pc);
    border-color: var(--pc);
    color: var(--ink);
  }
  .pl {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pc);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 13px;
  }
  .src {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }









  /* Key for the level bars; only shown on phones, where rows drop the level word. */
  .level-key {
    display: none;
  }
  @media (max-width: 640px) {
    .level-key {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      list-style: none;
      margin: 18px 0 0;
      padding: 0;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .level-key li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .level-key .meter i {
      width: 5px;
      height: 11px;
      border-width: 1px;
      border-radius: 2px;
    }
    /* Compact two-line rows: name + bars, then project dots and sources. */
    .row {
      grid-template-columns: minmax(0, 1fr) auto !important;
      gap: 6px 12px !important;
      padding: 11px 2px !important;
    }
    .sname {
      font-size: 15px;
      line-height: 1.3;
    }
    .lt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .level .meter {
      gap: 3px;
    }
    .level .meter i {
      width: 6px;
      height: 13px;
      border-width: 1px;
      border-radius: 2px;
    }
    .used {
      gap: 4px 8px;
      align-items: center;
    }
    .used:empty {
      display: none;
    }
    .pchip {
      padding: 0 !important;
      border: 0;
    }
    .pl {
      width: 20px;
      height: 20px;
      font-size: 11.5px;
    }
    .src {
      padding: 0;
      border: 0;
      font-size: 11px;
    }
    .pchip + .src::before {
      content: '·\00a0';
    }
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 10px 12px;
    }
    .used {
      grid-column: 1 / -1;
    }
    .pn {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .pchip {
      padding-right: 3px;
    }
  }
  /* Every group is one even row: title | tagline | count | +/− (tagline hidden on phones). */
  .group {
    padding-top: 0;
  }
  .group:first-of-type {
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }
  .ghead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 22px;
    grid-template-areas: 'title pun count plus';
    align-items: center;
    gap: 6px 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .group[open] > .ghead {
    border-bottom: 1.5px solid var(--fg);
  }
  .ghead::after {
    content: '+';
    grid-area: plus;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 22px;
    line-height: 1;
    transition: color 0.2s ease;
  }
  .ghead:hover::after {
    color: var(--pink);
  }
  .group[open] > .ghead::after {
    content: '−';
  }
  .gtitle {
    grid-area: title;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1;
    white-space: nowrap;
  }
  .gpun {
    grid-area: pun;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gcount {
    grid-area: count;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .group[open] .rows {
    margin: 10px 0 28px;
  }
  @media (max-width: 640px) {
    .group:first-of-type {
      margin-top: 18px;
    }
    .ghead {
      grid-template-columns: minmax(0, 1fr) 22px;
      grid-template-areas:
        'title plus'
        'count plus';
      gap: 4px 12px;
      padding: 14px 0;
    }
    .gtitle {
      font-size: clamp(22px, 6.8vw, 26px);
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .gpun {
      display: none;
    }
    .group[open] .rows {
      margin: 8px 0 20px;
    }
  }
</style>

<script>
  // A link to a skill (or a group) opens the group that holds it.
  const reveal = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    const d = el ? (el.closest('details') as HTMLDetailsElement | null) : null;
    if (d && !d.open) {
      d.open = true;
      el.scrollIntoView();
    }
  };
  reveal();
  window.addEventListener('hashchange', reveal);
</script>
