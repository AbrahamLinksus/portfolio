---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RideMap from '../components/RideMap.astro';
import DrumKitGraphic from '../components/DrumKitGraphic.astro';
import { music, biking, drums, badminton } from '../data/hobbies';
import { km } from '../lib/geo';

const tabs = [
  { id: 'music', label: 'Music', color: 'var(--teal)' },
  { id: 'biking', label: 'Biking', color: 'var(--orange)' },
  { id: 'drums', label: 'Drums', color: 'var(--pink)' },
  { id: 'badminton', label: 'Badminton', color: 'var(--lime)' },
];
const bikeFacts = [...biking.stats, { value: `${biking.longest.from} → ${biking.longest.to}`, label: 'longest ride', wide: true }];
const drumFacts = [...drums.stats, { value: drums.favourite, label: 'favourite to play' }];
---

<BaseLayout title="Hobbies" description="Music, motorbike rides, drums and badminton: what Jake Roberts does away from the keyboard.">
  <PageIntro number="04" title="Hobbies" lede="Four things I do away from the keyboard." />

  <section class="container hobbies" data-tabs>
    <div class="tablist" role="tablist" aria-label="Hobbies">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
            style={`--c: ${t.color}`}
          >
            <span class="tn">{String(i + 1).padStart(2, '0')}</span>
            <span class="tl">{t.label}</span>
          </button>
        ))
      }
    </div>

    <!-- MUSIC -->
    <div class="panel" role="tabpanel" id="panel-music" aria-labelledby="tab-music" tabindex="0" style="--c: var(--teal)">
      <div class="music-top">
        <div class="about">
          {music.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
          <p class="genre"><span>Genre</span>{music.genre}</p>
        </div>
        <div class="rank-wrap">
          <h2 class="bh">Top 5 artists</h2>
          <ol class="rank">
            {
              music.topArtists.map((a, i) => (
                <li>
                  <span class="rn">{i + 1}</span>
                  <span class="ra">{a}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
      <div class="band">
        <div>
          <h2 class="bh">Coding soundtrack</h2>
          <p class="band-big">{music.soundtrack.artist}</p>
          <p class="band-note">{music.soundtrack.line}</p>
        </div>
        <div>
          <h2 class="bh">Drummers I study</h2>
          <ul class="people">
            {
              music.drummers.map((d) => (
                <li>
                  <span class="pname">{d.name}</span>
                  <span class="pband">{d.band}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- BIKING -->
    <div class="panel" role="tabpanel" id="panel-biking" aria-labelledby="tab-biking" tabindex="0" style="--c: var(--orange)" hidden>
      <dl class="facts">
        {
          bikeFacts.map((f) => (
            <div class:list={['fact', { wide: 'wide' in f }]}>
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="bike">
        <figure class="map">
          <RideMap home={biking.home} places={[...biking.routes, biking.longestRide]} />
          <figcaption class="cap">Straight-line distances from home. Roads are longer.</figcaption>
        </figure>
        <div class="routes-wrap">
          <h2 class="bh">Favourite routes</h2>
          <ol class="routes">
            {
              biking.routes.map((r, i) => (
                <li>
                  <span class="rn">{i + 1}</span>
                  <span>
                    <span class="rname">{r.name}</span>
                    <span class="rnote">{r.note} · {km(biking.home, r)} km away</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <!-- DRUMS -->
    <div class="panel" role="tabpanel" id="panel-drums" aria-labelledby="tab-drums" tabindex="0" style="--c: var(--pink)" hidden>
      <dl class="facts">
        {
          drumFacts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="kit">
        <DrumKitGraphic
          kick={{ value: '13', label: 'YEARS PLAYING' }}
          snare={{ value: 'PROG', label: '& ROCK' }}
          tom1={{ value: 'FREE BIRD', label: 'FAVOURITE' }}
          tom2={{ value: 'HOME', label: 'PRACTICE' }}
          floor={{ value: 'CHURCH', label: 'LIVE' }}
          hihat={{ value: 'YAMAHA', label: 'THE KIT' }}
          crash={{ value: 'MIXED', label: 'CYMBALS' }}
          ride={{ value: 'PORTNOY', label: '& CAREY' }}
        />
      </div>
    </div>

    <!-- BADMINTON -->
    <div class="panel" role="tabpanel" id="panel-badminton" aria-labelledby="tab-badminton" tabindex="0" style="--c: var(--lime)" hidden>
      <p class="big-line">{badminton.line}</p>
      <div class="photos">
        {
          Array.from({ length: badminton.photoSlots }, () => (
            <div class="photo">
              <span>Photo coming soon</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tabs */
  .tablist {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 40px;
  }
  .tab {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 16px;
    border: 2px solid var(--c);
    color: var(--fg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tab:hover {
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .tab[aria-selected='true'] {
    background: var(--c);
    color: var(--ink);
  }
  .tab:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  .tn {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.75;
  }
  .tl {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(16px, 2vw, 22px);
  }

  .panel {
    display: grid;
    gap: 44px;
  }
  .panel[hidden] {
    display: none !important;
  }
  .panel:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 8px;
    border-radius: 8px;
  }
  .bh {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }

  /* Music */
  .music-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .about {
    display: grid;
    gap: 18px;
  }
  .about p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }
  .about p.lead {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.38;
    color: var(--fg);
  }
  .about p.genre {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 6px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 20px;
    color: var(--c);
  }
  .genre span {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .rank,
  .routes,
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rank li,
  .routes li {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .rank li:first-child,
  .routes li:first-child {
    border-top: 1px solid var(--line);
  }
  .rn {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
    color: var(--c);
  }
  .ra {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .rank li:first-child .ra {
    font-size: clamp(40px, 4.8vw, 60px);
  }
  .rank li:first-child .rn {
    font-size: 40px;
  }

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    border-radius: 22px;
    background: var(--c);
    color: var(--ink);
    overflow: hidden;
  }
  .band > div {
    padding: 26px 30px;
  }
  .band > div + div {
    border-left: 2px solid rgba(17, 17, 18, 0.18);
  }
  .band .bh {
    color: rgba(17, 17, 18, 0.7);
  }
  .band-big {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    text-transform: uppercase;
  }
  .band-note {
    margin: 10px 0 0;
    font-size: 16px;
  }
  .people {
    display: grid;
    gap: 14px;
  }
  .people li {
    display: grid;
    gap: 2px;
  }
  .pname {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 22px;
  }
  .pband {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(17, 17, 18, 0.7);
  }

  /* Facts strip (biking, drums) */
  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    border-top: 3px solid var(--c);
    border-bottom: 1px solid var(--line);
  }
  .fact {
    flex: 1 1 160px;
    padding: 18px 22px 20px;
    border-left: 1px solid var(--line);
  }
  .fact:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .fact.wide {
    flex: 2 1 300px;
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dd {
    margin: 8px 0 0;
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1;
    color: var(--c);
    text-transform: uppercase;
  }
  .fact.wide dd {
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.1;
  }

  /* Biking */
  .bike {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .map {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .cap {
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: #151313;
  }
  .rname {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .rnote {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }

  /* Drums */
  .kit {
    padding: 12px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  /* Badminton */
  .big-line {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .photo {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 18px;
    border: 2px dashed color-mix(in srgb, var(--c) 55%, transparent);
    background: var(--surface);
  }
  .photo span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .music-top,
    .bike,
    .band {
      grid-template-columns: 1fr;
    }
    .music-top {
      gap: 40px;
    }
    .band > div + div {
      border-left: 0;
      border-top: 2px solid rgba(17, 17, 18, 0.18);
    }
  }
  @media (max-width: 600px) {
    .tablist {
      grid-template-columns: 1fr 1fr;
      margin-bottom: 32px;
    }
    .panel {
      gap: 36px;
    }
    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .fact,
    .fact:first-child {
      padding: 16px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .fact:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .fact.wide {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
      border-bottom: 0;
    }
    .facts > .fact:last-child:not(.wide) {
      border-bottom: 0;
    }
    .band > div {
      padding: 22px;
    }
    .photos {
      grid-template-columns: 1fr;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const ids = tabs.map((t) => t.dataset.tab!);

    const select = (id: string, focus = false, push = true) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        if (on && focus) t.focus();
      });
      if (push) history.replaceState(null, '', `#${id}`);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(ids[j], true);
      });
    });

    const fromHash = () => {
      const h = location.hash.slice(1);
      if (ids.includes(h)) select(h, false, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
