---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { hobbies, topArtists, drummers, codingSoundtrack } from '../data/hobbies';
import CourtGraphic from '../components/CourtGraphic.astro';
import DrumKitGraphic from '../components/DrumKitGraphic.astro';

const music = hobbies.find((h) => h.id === 'music')!;
---

<BaseLayout title="Hobbies" description="Badminton, drums and progressive rock: life outside the terminal.">
  <PageIntro number="03" title="Hobbies" lede="Offline mode: on. Three things I do every day, all of them a little too seriously." />

  <div class="container deck" data-deck>
    <button type="button" class="tile" id="tile-badminton" data-key="badminton" aria-expanded="false" aria-controls="panel-badminton" style="--c: var(--lime); --o: 1">
      <span class="t-num">01</span>
      <span class="t-name display">Badminton</span>
      <span class="t-stat"><b>3h</b> a day, every day</span>
      <span class="t-icon" aria-hidden="true">+</span>
    </button>
    <section class="panel" id="panel-badminton" data-panel="badminton" role="region" aria-labelledby="tile-badminton" style="--c: var(--lime); --o: 2" hidden>
      <div class="panel-in">
        <p class="line">Three hours a day on my home court, every day, for five years.</p>
        <CourtGraphic
          boxes={[
            { value: '5', label: 'YEARS PLAYING' },
            { value: '365', label: 'DAYS A YEAR' },
            { value: '3H', label: 'EVERY DAY' },
            { value: '5,000+', label: 'HOURS ON COURT' },
          ]}
        />
      </div>
    </section>

    <button type="button" class="tile" id="tile-drums" data-key="drums" aria-expanded="false" aria-controls="panel-drums" style="--c: var(--pink); --o: 1">
      <span class="t-num">02</span>
      <span class="t-name display">Drums</span>
      <span class="t-stat"><b>13</b> years behind the kit</span>
      <span class="t-icon" aria-hidden="true">+</span>
    </button>
    <section class="panel" id="panel-drums" data-panel="drums" role="region" aria-labelledby="tile-drums" style="--c: var(--pink); --o: 2" hidden>
      <div class="panel-in">
        <p class="line">Thirteen years behind a Yamaha kit, playing progressive rock at home and in church.</p>
        <DrumKitGraphic
          kick={{ value: '13', label: 'YEARS PLAYING' }}
          snare={{ value: 'PROG', label: '& ROCK' }}
          tom1={{ value: 'FREE BIRD', label: 'FAVOURITE' }}
          tom2={{ value: 'BAND', label: 'NAME TBA' }}
          floor={{ value: 'HOME', label: 'PRACTICE' }}
          hihat={{ value: 'YAMAHA', label: 'THE KIT' }}
          crash={{ value: 'MIXED', label: 'CYMBALS' }}
          ride={{ value: 'CHURCH', label: 'LIVE' }}
        />
      </div>
    </section>

    <button type="button" class="tile" id="tile-music" data-key="music" aria-expanded="false" aria-controls="panel-music" style="--c: var(--teal); --o: 1">
      <span class="t-num">03</span>
      <span class="t-name display">Music</span>
      <span class="t-stat"><b>5h</b> of prog a day</span>
      <span class="t-icon" aria-hidden="true">+</span>
    </button>
    <section class="panel" id="panel-music" data-panel="music" role="region" aria-labelledby="tile-music" style="--c: var(--teal); --o: 2" hidden>
      <div class="panel-in">
        <p class="tagline">{music.tagline}</p>
        <ul class="stats">
          {
            music.stats.map((s) => (
              <li>
                <span class="sv">{s.value}</span>
                <span class="sl">{s.label}</span>
              </li>
            ))
          }
        </ul>
        <div class="text">{music.body.map((p) => <p>{p}</p>)}</div>
        <div class="music-grid">
          <div class="card repeat">
            <span class="label">On repeat · top 5</span>
            <ol class="artists">
              {
                topArtists.map((a, i) => (
                  <li>
                    <span class="rank">{i + 1}</span>
                    <span class="an">{a}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="card soundtrack">
            <span class="label">Coding soundtrack</span>
            <p class="st-artist display">{codingSoundtrack.artist}</p>
            <p>{codingSoundtrack.line}</p>
            <p class="pun">{codingSoundtrack.pun}</p>
          </div>
          <div class="card drummers">
            <span class="label">Drummers I study</span>
            <ul>
              {
                drummers.map((d) => (
                  <li>
                    <span class="dn">{d.name}</span>
                    <span class="db">{d.band} · in my top 5</span>
                    <span class="dt">{d.note}</span>
                  </li>
                ))
              }
            </ul>
            <a class="link" href="#drums">Open my own kit ↑</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Deck: three tiles in a row; the open panel spans the full width beneath them. */
  .deck {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding-top: 8px;
  }
  .tile {
    all: unset;
    box-sizing: border-box;
    grid-row: 1;
    cursor: pointer;
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 18px;
    min-height: 260px;
    padding: 22px;
    border-radius: 20px;
    border: 2px solid var(--c);
    color: var(--fg);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }
  .tile:hover {
    transform: translateY(-3px);
  }
  .tile:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  .tile[aria-expanded='true'] {
    background: var(--c);
    color: var(--ink);
  }
  .t-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .t-name {
    font-size: clamp(44px, 5.6vw, 84px);
    color: var(--c);
    overflow-wrap: anywhere;
  }
  .tile[aria-expanded='true'] .t-name {
    color: var(--ink);
  }
  .t-stat {
    font-size: 15px;
  }
  .t-stat b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    margin-right: 6px;
    vertical-align: -3px;
  }
  .t-icon {
    position: absolute;
    top: 16px;
    right: 18px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 26px;
    line-height: 1;
    background: var(--c);
    color: var(--ink);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .tile[aria-expanded='true'] .t-icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--c);
  }
  .panel {
    grid-row: 2;
    grid-column: 1 / -1;
    border-top: 3px solid var(--c);
    padding-top: 22px;
    margin-top: 6px;
    scroll-margin-top: 24px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel:not([hidden]) .panel-in {
    animation: open 0.35s ease both;
  }
  @keyframes open {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: none; }
  }
  .panel-in {
    display: grid;
    gap: 22px;
  }
  .panel-in > :global(svg) {
    max-width: 880px;
    width: 100%;
    justify-self: center;
  }
  @media (max-width: 760px) {
    .deck {
      grid-template-columns: 1fr;
    }
    .tile,
    .panel {
      grid-row: auto;
    }
    .tile {
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile,
    .t-icon,
    .panel:not([hidden]) .panel-in {
      transition: none;
      animation: none;
    }
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 8px;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border-radius: 99px;
    border: 1.5px solid var(--c);
    text-decoration: none;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 14px;
  }
  .jump a:hover,
  .jump a:focus-visible {
    background: var(--c);
    color: var(--ink);
  }
  .jump .num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }

  .hobby {
    display: grid;
    gap: 24px;
    padding-top: 72px;
    scroll-margin-top: 24px;
  }
  .head {
    display: grid;
    gap: 8px;
    border-top: 3px solid var(--c);
    padding-top: 18px;
  }
  .name {
    font-size: clamp(64px, 12vw, 150px);
    color: var(--c);
  }
  .visual {
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.5fr);
    align-items: end;
    column-gap: 40px;
  }
  .visual .head {
    align-self: stretch;
    align-content: start;
  }
  .visual .name {
    font-size: clamp(52px, 6.2vw, 88px);
    overflow-wrap: anywhere;
  }
  .line {
    margin: 4px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 36ch;
  }
  .art {
    min-width: 0;
  }
  .tagline {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(18px, 2.4vw, 26px);
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .stats li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .sv {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 72px);
    line-height: 0.9;
    color: var(--c);
  }
  .sl {
    font-size: 14px;
    color: var(--muted);
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .text p {
    margin: 0 0 12px;
    font-size: 17px;
    line-height: 1.65;
    max-width: 60ch;
  }
  .stickers {
    list-style: none;
    margin: 0;
    padding: 6px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stickers li {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 15px;
    line-height: 1.1;
    transform: rotate(var(--r));
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
  }

  .music-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    gap: 12px;
    align-items: stretch;
  }
  .card {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .artists {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .artists li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rank {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 16px;
  }
  .an {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 18px;
  }
  .soundtrack {
    background: var(--panel);
    color: var(--ink);
    border-color: var(--panel);
  }
  .soundtrack .label {
    color: #5e5a55;
  }
  .soundtrack p {
    margin: 0;
  }
  .st-artist {
    font-size: clamp(40px, 5vw, 60px);
  }
  .pun {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 14px;
    justify-self: start;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--c);
    transform: rotate(-2deg);
  }
  .drummers ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .drummers li {
    display: grid;
    gap: 2px;
  }
  .dn {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 28px;
    line-height: 1;
  }
  .db {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c);
  }
  .dt {
    font-size: 14px;
    color: var(--muted);
  }
  .link {
    font-size: 13px;
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .visual {
      grid-template-columns: 1fr;
    }
    .body,
    .music-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const tiles = [...deck.querySelectorAll<HTMLButtonElement>('.tile')];
    const panels = [...deck.querySelectorAll<HTMLElement>('[data-panel]')];
    const open = (key: string | null, scroll = false) => {
      tiles.forEach((t) => t.setAttribute('aria-expanded', String(t.dataset.key === key)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
      if (key) {
        history.replaceState(null, '', '#' + key);
        if (scroll) deck.querySelector('#panel-' + key)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else history.replaceState(null, '', location.pathname);
    };
    tiles.forEach((t) =>
      t.addEventListener('click', () => open(t.getAttribute('aria-expanded') === 'true' ? null : t.dataset.key!, true)),
    );
    const fromHash = () => {
      const key = location.hash.slice(1);
      if (tiles.some((t) => t.dataset.key === key)) open(key, true);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
