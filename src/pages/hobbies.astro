---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RideMap from '../components/RideMap.astro';
import DrumKitGraphic from '../components/DrumKitGraphic.astro';
import { music, biking, drums, badminton } from '../data/hobbies';
import { km } from '../lib/geo';

const tabs = [
  { id: 'music', label: 'Music', color: 'var(--teal)' },
  { id: 'biking', label: 'Biking', color: 'var(--orange)' },
  { id: 'drums', label: 'Drums', color: 'var(--pink)' },
  { id: 'badminton', label: 'Badminton', color: 'var(--lime)' },
];
const drumFacts = [...drums.stats, { value: drums.favourite, label: 'favourite to play' }];
---

<BaseLayout title="Hobbies" description="Music, motorbike rides, drums and badminton: what Jake Roberts does away from the keyboard.">
  <PageIntro number="04" title="Hobbies" lede="Four things I do away from the keyboard." />

  <section class="container hobbies" data-tabs>
    <div class="tablist" role="tablist" aria-label="Hobbies">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
            style={`--c: ${t.color}`}
          >
            <span class="tn">{String(i + 1).padStart(2, '0')}</span>
            <span class="tl">{t.label}</span>
          </button>
        ))
      }
    </div>

    <!-- MUSIC -->
    <div class="panel" role="tabpanel" id="panel-music" aria-labelledby="tab-music" tabindex="0" style="--c: var(--teal)">
      <div class="music-top">
        <div class="about">
          {music.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
        </div>
        <section class="top5-wrap" aria-labelledby="top5-title">
          <div class="desk">
            <div class="desk-head">
              <h2 id="top5-title">Top 5 artists</h2>
              <span>{music.genre}</span>
            </div>

          <ol class="top5">
            {
              music.topArtists.map((a, i) => {
                const lvl = [1, 0.84, 0.72, 0.62, 0.54][i] ?? 0.5;
                const lit = Math.round(lvl * 14);
                return (
                  <li class="ch" style={`--lvl: ${lvl}`}>
                    <span class="ch-n">CH {String(i + 1).padStart(2, '0')}</span>
                    <span class="meter" aria-hidden="true">
                      {Array.from({ length: 14 }, (_, k) => (
                        <i class:list={{ on: k < lit, hot: k >= 11, warm: k >= 8 && k < 11 }} style={`--d: ${(k * 37) % 9}`} />
                      ))}
                    </span>
                    <span class="fader" aria-hidden="true">
                      <span class="knob" />
                    </span>
                    <span class="tape">
                      <span class="visually-hidden">Number {i + 1}: </span>
                      {a}
                    </span>
                  </li>
                );
              })
            }
          </ol>
          </div>
        </section>
      </div>

      <section aria-labelledby="sound-title">
        <div class="sec-head">
          <h2 id="sound-title" class="display sec-title">Coding soundtrack</h2>
          <span class="label">Full albums, start to finish</span>
        </div>
        <ul class="albums">
          {
            music.soundtrack.map((a) => (
              <li>
                <span class="item-name">{a.album}</span>
                <span class="label">{a.artist}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- BIKING -->
    <div class="panel" role="tabpanel" id="panel-biking" aria-labelledby="tab-biking" tabindex="0" style="--c: var(--orange)" hidden>
      <div class="about">
        {biking.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>
      <dl class="facts">
        {
          biking.stats.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <section aria-labelledby="rides-title">
        <div class="sec-head">
          <h2 id="rides-title" class="display sec-title">Where I ride</h2>
          <span class="label">From Coimbatore and Chennai</span>
        </div>
        <div class="bike">
          <figure class="map">
            <div class="map-scroll">
              <RideMap homes={biking.homes} places={biking.routes} view={biking.view} regions={biking.regions} />
            </div>
            <figcaption class="cap"><span class="swipe">Swipe the map to see Chennai →<br /></span>Straight-line distances from each starting point. Roads are longer.</figcaption>
          </figure>
          <div class="ride-lists">
            {
              biking.homes.map((h) => (
                <div>
                  <h3 class="list-head">From {h.name}</h3>
                  <ul class="rows routes">
                    {biking.routes
                      .filter((r) => r.from === h.name && r.inList !== false)
                      .map((r) => (
                        <li>
                          <span class="item-name">{r.name}</span>
                          <span class="item-note">
                            {r.note} · {km(h, r)} km
                          </span>
                        </li>
                      ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>

    <!-- DRUMS -->
    <div class="panel" role="tabpanel" id="panel-drums" aria-labelledby="tab-drums" tabindex="0" style="--c: var(--pink)" hidden>
      <dl class="facts">
        {
          drumFacts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="kit">
        <DrumKitGraphic
          kick={{ value: '13', label: 'YEARS PLAYING' }}
          snare={{ value: 'PROG', label: '& ROCK' }}
          tom1={{ value: 'FREE BIRD', label: 'FAVOURITE' }}
          tom2={{ value: 'HOME', label: 'PRACTICE' }}
          floor={{ value: 'CHURCH', label: 'LIVE' }}
          hihat={{ value: 'YAMAHA', label: 'THE KIT' }}
          crash={{ value: 'MIXED', label: 'CYMBALS' }}
          ride={{ value: 'PORTNOY', label: '& CAREY' }}
        />
      </div>
    </div>

    <!-- BADMINTON -->
    <div class="panel" role="tabpanel" id="panel-badminton" aria-labelledby="tab-badminton" tabindex="0" style="--c: var(--lime)" hidden>
      <p class="big-line">{badminton.line}</p>
      <div class="photos">
        {
          Array.from({ length: badminton.photoSlots }, () => (
            <div class="photo">
              <span>Photo coming soon</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tabs */
  .tablist {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 40px;
  }
  .tab {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 16px;
    border: 2px solid var(--c);
    color: var(--fg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tab:hover {
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .tab[aria-selected='true'] {
    background: var(--c);
    color: var(--ink);
  }
  .tab:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  .tn {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.75;
  }
  .tl {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(16px, 2vw, 22px);
  }

  .panel {
    display: grid;
    gap: 44px;
  }
  .panel[hidden] {
    display: none !important;
  }
  .panel:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 8px;
    border-radius: 8px;
  }
  /* Shared type, matching the rest of the site */
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 22px;
  }
  .sec-title {
    font-size: clamp(36px, 5vw, 60px);
  }
  .sec-title.sm {
    font-size: clamp(30px, 3.6vw, 44px);
  }
  .item-name {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 22px;
    line-height: 1.1;
  }
  .item-note {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  /* Music */
  .about {
    display: grid;
    gap: 18px;
  }
  .about p {
    margin: 0;
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }
  .about p.lead {
    max-width: 36em;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.18;
    color: var(--fg);
  }
  /* Top 5 as a mixing desk: one channel per artist, #1 pushed to the top. */
  .music-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .music-top .about p.lead {
    font-size: clamp(19px, 1.9vw, 24px);
  }
  .music-top .about p {
    font-size: 17px;
  }
  .desk-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .desk-head h2 {
    margin: 0;
    font: inherit;
    color: var(--c);
  }
  .desk {
    padding: 14px;
    border-radius: 22px;
    background: linear-gradient(180deg, #1c1b1b, #121111);
    border: 1px solid var(--line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .top5 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .ch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'n n'
      'm f'
      't t';
    gap: 10px 4px;
    justify-items: center;
    padding: 10px 6px 8px;
    border-radius: 14px;
    background: #181717;
    border: 1px solid #262424;
  }
  .ch-n {
    grid-area: n;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .ch:first-child .ch-n {
    color: var(--c);
  }
  .meter {
    grid-area: m;
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    height: 120px;
  }
  .meter i {
    flex: 1;
    width: 9px;
    border-radius: 2px;
    background: #262424;
  }
  .meter i.on {
    background: var(--lime);
  }
  .meter i.on.warm {
    background: var(--yellow);
  }
  .meter i.on.hot {
    background: var(--pink);
    box-shadow: 0 0 8px rgba(244, 80, 122, 0.6);
  }
  .fader {
    grid-area: f;
    position: relative;
    width: 5px;
    height: 120px;
    border-radius: 3px;
    background: #0a0a0a;
    box-shadow: inset 0 0 0 1px #2e2b2b;
  }
  .knob {
    position: absolute;
    left: 50%;
    bottom: calc(var(--lvl) * (100% - 22px));
    width: 24px;
    height: 22px;
    transform: translateX(-50%);
    border-radius: 5px;
    background: linear-gradient(180deg, #f2ece4 0 46%, #111112 46% 54%, #d9d1c6 54%);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.5);
  }
  .tape {
    grid-area: t;
    justify-self: stretch;
    display: grid;
    place-items: center;
    min-height: 40px;
    padding: 4px 4px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.05;
    clip-path: polygon(0 4%, 3% 0, 97% 3%, 100% 0, 99% 50%, 100% 96%, 96% 100%, 4% 97%, 0 100%, 1% 50%);
  }
  .ch:first-child .tape {
    background: var(--c);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .meter i.on:nth-last-child(-n + 14) {
      animation: flicker 1.6s ease-in-out infinite;
      animation-delay: calc(var(--d) * -0.17s);
    }
    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.55; }
    }
  }

  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .albums li {
    display: grid;
    align-content: space-between;
    gap: 18px;
    min-height: 150px;
    padding: 18px;
    border: 1.5px solid var(--line);
    border-top: 4px solid var(--c);
    border-radius: 16px;
  }
  .albums .item-name {
    font-size: clamp(18px, 1.8vw, 22px);
  }
  .rows,
  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .rows li:first-child {
    padding-top: 0;
  }
  .routes li {
    display: block;
  }
  .ride-lists {
    display: grid;
    gap: 32px;
  }
  .list-head {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }
  .routes .item-name,
  .routes .item-note {
    display: block;
  }

  /* Facts strip (biking, drums) */
  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    border-top: 3px solid var(--c);
    border-bottom: 1px solid var(--line);
  }
  .fact {
    flex: 1 1 160px;
    padding: 18px 22px 20px;
    border-left: 1px solid var(--line);
  }
  .fact:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .fact.wide {
    flex: 2 1 300px;
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dd {
    margin: 8px 0 0;
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1;
    color: var(--c);
    text-transform: uppercase;
  }
  .fact.wide dd {
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.1;
  }

  /* Biking */
  .bike {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .map {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .swipe {
    display: none;
    color: var(--c);
  }
  .cap {
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: #151313;
  }

  /* Drums */
  .kit {
    padding: 12px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  /* Badminton */
  .big-line {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .photo {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 18px;
    border: 2px dashed color-mix(in srgb, var(--c) 55%, transparent);
    background: var(--surface);
  }
  .photo span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .bike,
    .music-top {
      grid-template-columns: 1fr;
    }
    .albums {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .desk {
      padding: 12px;
    }
    .top5 {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .ch {
      grid-template-columns: 40px minmax(0, 1fr) 84px;
      grid-template-areas: 'n t m';
      justify-items: stretch;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
    }
    .meter {
      flex-direction: row;
      height: 12px;
    }
    .meter i {
      width: auto;
      height: 12px;
    }
    .fader {
      display: none;
    }
    .tape {
      min-height: 0;
      justify-items: start;
      text-align: left;
      font-size: 15px;
      padding: 5px 8px;
    }
    .tablist {
      grid-template-columns: 1fr 1fr;
      margin-bottom: 32px;
    }
    .panel {
      gap: 36px;
    }
    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .fact,
    .fact:first-child {
      padding: 16px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .fact:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .fact.wide {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
      border-bottom: 0;
    }
    .facts > .fact:last-child:not(.wide) {
      border-bottom: 0;
    }
    .photos {
      grid-template-columns: 1fr;
    }
    .swipe {
      display: inline;
    }
    .map-scroll :global(.ridemap) {
      width: 640px;
      max-width: none;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const ids = tabs.map((t) => t.dataset.tab!);

    const select = (id: string, focus = false, push = true) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        if (on && focus) t.focus();
      });
      if (push) history.replaceState(null, '', `#${id}`);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(ids[j], true);
      });
    });

    const fromHash = () => {
      const h = location.hash.slice(1);
      if (ids.includes(h)) select(h, false, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
