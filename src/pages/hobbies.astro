---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RideMap from '../components/RideMap.astro';
import DrumKitGraphic from '../components/DrumKitGraphic.astro';
import { music, biking, drums, badminton } from '../data/hobbies';
import { km } from '../lib/geo';

const tabs = [
  { id: 'music', label: 'Music', color: 'var(--teal)' },
  { id: 'biking', label: 'Biking', color: 'var(--orange)' },
  { id: 'drums', label: 'Drums', color: 'var(--pink)' },
  { id: 'badminton', label: 'Badminton', color: 'var(--lime)' },
];
---

<BaseLayout title="Hobbies" description="Music, motorbike rides, drums and badminton: what Jake Roberts does away from the keyboard.">
  <PageIntro number="04" title="Hobbies" lede="Four things I do away from the keyboard." />

  <section class="container hobbies" data-tabs>
    <div class="tablist" role="tablist" aria-label="Hobbies">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
            style={`--c: ${t.color}`}
          >
            <span class="tn">{String(i + 1).padStart(2, '0')}</span>
            <span class="tl">{t.label}</span>
          </button>
        ))
      }
    </div>

    <!-- MUSIC -->
    <div class="panel" role="tabpanel" id="panel-music" aria-labelledby="tab-music" tabindex="0" style="--c: var(--teal)">
      <div class="about">
        {music.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>
      <div class="stats">
        {
          music.stats.map((s) => (
            <div class="stat">
              <span class="sv display">{s.value}</span>
              <span class="sl">{s.label}</span>
            </div>
          ))
        }
      </div>
      <div class="grid2">
        <div class="block">
          <h2 class="bh">Top 5 artists</h2>
          <ol class="artists">
            {
              music.topArtists.map((a, i) => (
                <li>
                  <span class="an">{String(i + 1).padStart(2, '0')}</span>
                  <span class="aa">{a}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="stack">
          <div class="block card">
            <h2 class="bh">Coding soundtrack</h2>
            <p class="big">{music.soundtrack.artist}</p>
            <p class="note">{music.soundtrack.line}</p>
          </div>
          <div class="block card">
            <h2 class="bh">Drummers I study</h2>
            <ul class="people">
              {
                music.drummers.map((d) => (
                  <li>
                    <span class="pname">{d.name}</span>
                    <span class="pband">{d.band}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- BIKING -->
    <div class="panel" role="tabpanel" id="panel-biking" aria-labelledby="tab-biking" tabindex="0" style="--c: var(--orange)" hidden>
      <div class="stats">
        {
          biking.stats.map((s) => (
            <div class="stat">
              <span class="sv display">{s.value}</span>
              <span class="sl">{s.label}</span>
            </div>
          ))
        }
        <div class="stat">
          <span class="sv display sv-sm">{biking.longest.from} → {biking.longest.to}</span>
          <span class="sl">longest ride</span>
        </div>
      </div>
      <div class="grid-map">
        <div class="block">
          <h2 class="bh">Favourite routes</h2>
          <ol class="routes">
            {
              biking.routes.map((r, i) => (
                <li>
                  <span class="an">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="aa">{r.name}</span>
                    <span class="rnote">{r.note} · {km(biking.home, r)} km away</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="map">
          <RideMap home={biking.home} places={[...biking.routes, biking.longestRide]} />
          <p class="cap">Straight-line distances from home. Roads are longer.</p>
        </div>
      </div>
    </div>

    <!-- DRUMS -->
    <div class="panel" role="tabpanel" id="panel-drums" aria-labelledby="tab-drums" tabindex="0" style="--c: var(--pink)" hidden>
      <div class="stats">
        {
          drums.stats.map((s) => (
            <div class="stat">
              <span class="sv display">{s.value}</span>
              <span class="sl">{s.label}</span>
            </div>
          ))
        }
        <div class="stat">
          <span class="sv display">{drums.favourite}</span>
          <span class="sl">favourite to play</span>
        </div>
      </div>
      <div class="kit">
        <DrumKitGraphic
          kick={{ value: '13', label: 'YEARS PLAYING' }}
          snare={{ value: 'PROG', label: '& ROCK' }}
          tom1={{ value: 'FREE BIRD', label: 'FAVOURITE' }}
          tom2={{ value: 'HOME', label: 'PRACTICE' }}
          floor={{ value: 'CHURCH', label: 'LIVE' }}
          hihat={{ value: 'YAMAHA', label: 'THE KIT' }}
          crash={{ value: 'MIXED', label: 'CYMBALS' }}
          ride={{ value: 'PORTNOY', label: '& CAREY' }}
        />
      </div>
    </div>

    <!-- BADMINTON -->
    <div class="panel" role="tabpanel" id="panel-badminton" aria-labelledby="tab-badminton" tabindex="0" style="--c: var(--lime)" hidden>
      <p class="lead">{badminton.line}</p>
      <div class="photos">
        {
          Array.from({ length: badminton.photoSlots }, () => (
            <div class="photo">
              <span>Photo coming soon</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tablist {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 28px;
  }
  .tab {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 16px;
    border: 2px solid var(--c);
    color: var(--fg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tab:hover {
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .tab[aria-selected='true'] {
    background: var(--c);
    color: var(--ink);
  }
  .tab:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  .tn {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.75;
  }
  .tl {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(16px, 2vw, 22px);
  }

  .panel {
    display: grid;
    gap: 28px;
  }
  .panel[hidden] {
    display: none !important;
  }
  .panel:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 8px;
    border-radius: 8px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }
  .stat {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 20px 22px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--c);
  }
  .sv {
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    color: var(--c);
  }
  .sv-sm {
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
  }
  .sl {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .grid2 {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 16px;
  }
  .grid-map {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 20px;
    align-items: start;
  }
  .stack {
    display: grid;
    gap: 16px;
  }
  .block {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .card {
    padding: 22px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .bh {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .artists,
  .routes,
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .artists li,
  .routes li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .artists li:first-child,
  .routes li:first-child {
    border-top: 1px solid var(--line);
  }
  .an {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    flex: none;
  }
  .aa {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .routes .aa {
    display: block;
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .rnote {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .big {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1;
    text-transform: uppercase;
  }
  .note {
    margin: 0;
    font-size: 16px;
    color: var(--muted);
  }
  .people {
    display: grid;
    gap: 12px;
  }
  .people li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pname {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 18px;
  }
  .pband {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .map {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .cap {
    margin: 0;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: #151313;
  }
  .kit {
    padding: 12px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .about {
    display: grid;
    gap: 14px;
    max-width: 68ch;
  }
  .about p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }
  .about p.lead,
  .lead {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(22px, 2.6vw, 30px);
    color: var(--fg);
    line-height: 1.35;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .photo {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 18px;
    border: 2px dashed color-mix(in srgb, var(--c) 55%, transparent);
    background: var(--surface);
  }
  .photo span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .grid2,
    .grid-map {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .tablist {
      grid-template-columns: 1fr 1fr;
    }
    .photos {
      grid-template-columns: 1fr;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const ids = tabs.map((t) => t.dataset.tab!);

    const select = (id: string, focus = false, push = true) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        if (on && focus) t.focus();
      });
      if (push) history.replaceState(null, '', `#${id}`);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(ids[j], true);
      });
    });

    const fromHash = () => {
      const h = location.hash.slice(1);
      if (ids.includes(h)) select(h, false, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
