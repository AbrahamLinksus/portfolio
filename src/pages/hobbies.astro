---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RideMap from '../components/RideMap.astro';
import DrumKitGraphic from '../components/DrumKitGraphic.astro';
import { music, biking, drums, badminton } from '../data/hobbies';
import { km } from '../lib/geo';

const tabs = [
  { id: 'music', label: 'Music', color: 'var(--teal)' },
  { id: 'biking', label: 'Biking', color: 'var(--orange)' },
  { id: 'drums', label: 'Drums', color: 'var(--pink)' },
  { id: 'badminton', label: 'Badminton', color: 'var(--lime)' },
];
const drumFacts = [...drums.stats, { value: drums.favourite, label: 'favourite to play' }];
---

<BaseLayout title="Hobbies" description="Music, motorbike rides, drums and badminton: what Jake Roberts does away from the keyboard.">
  <PageIntro number="04" title="Hobbies" lede="Four things I do away from the keyboard." />

  <section class="container hobbies" data-tabs>
    <div class="tablist" role="tablist" aria-label="Hobbies">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
            style={`--c: ${t.color}`}
          >
            <span class="tn">{String(i + 1).padStart(2, '0')}</span>
            <span class="tl">{t.label}</span>
          </button>
        ))
      }
    </div>

    <!-- MUSIC -->
    <div class="panel" role="tabpanel" id="panel-music" aria-labelledby="tab-music" tabindex="0" style="--c: var(--teal)">
      <div class="about">
        {music.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>

      <section aria-labelledby="top5-title">
        <div class="sec-head">
          <h2 id="top5-title" class="display sec-title">Top 5 artists</h2>
          <span class="label">{music.genre}</span>
        </div>
        <ol class="top5">
          {
            music.topArtists.map((a, i) => (
              <li class:list={['artist', { first: i === 0 }]}>
                <span class="rank">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{a}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="sound-title">
        <div class="sec-head">
          <h2 id="sound-title" class="display sec-title">Coding soundtrack</h2>
          <span class="label">Full albums, start to finish</span>
        </div>
        <ul class="albums">
          {
            music.soundtrack.map((a) => (
              <li>
                <span class="item-name">{a.album}</span>
                <span class="label">{a.artist}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- BIKING -->
    <div class="panel" role="tabpanel" id="panel-biking" aria-labelledby="tab-biking" tabindex="0" style="--c: var(--orange)" hidden>
      <div class="about">
        {biking.about.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
      </div>
      <dl class="facts">
        {
          biking.stats.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <section aria-labelledby="rides-title">
        <div class="sec-head">
          <h2 id="rides-title" class="display sec-title">Where I ride</h2>
          <span class="label">From Coimbatore and Chennai</span>
        </div>
        <div class="bike">
          <figure class="map">
            <div class="map-scroll">
              <RideMap homes={biking.homes} places={biking.routes} view={biking.view} regions={biking.regions} />
            </div>
            <figcaption class="cap"><span class="swipe">Swipe the map to see Chennai →<br /></span>Straight-line distances from each starting point. Roads are longer.</figcaption>
          </figure>
          <div class="ride-lists">
            {
              biking.homes.map((h) => (
                <div>
                  <h3 class="list-head">From {h.name}</h3>
                  <ul class="rows routes">
                    {biking.routes
                      .filter((r) => r.from === h.name && r.inList !== false)
                      .map((r) => (
                        <li>
                          <span class="item-name">{r.name}</span>
                          <span class="item-note">
                            {r.note} · {km(h, r)} km
                          </span>
                        </li>
                      ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>

    <!-- DRUMS -->
    <div class="panel" role="tabpanel" id="panel-drums" aria-labelledby="tab-drums" tabindex="0" style="--c: var(--pink)" hidden>
      <dl class="facts">
        {
          drumFacts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd class="display">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="kit">
        <DrumKitGraphic
          kick={{ value: '13', label: 'YEARS PLAYING' }}
          snare={{ value: 'PROG', label: '& ROCK' }}
          tom1={{ value: 'FREE BIRD', label: 'FAVOURITE' }}
          tom2={{ value: 'HOME', label: 'PRACTICE' }}
          floor={{ value: 'CHURCH', label: 'LIVE' }}
          hihat={{ value: 'YAMAHA', label: 'THE KIT' }}
          crash={{ value: 'MIXED', label: 'CYMBALS' }}
          ride={{ value: 'PORTNOY', label: '& CAREY' }}
        />
      </div>
    </div>

    <!-- BADMINTON -->
    <div class="panel" role="tabpanel" id="panel-badminton" aria-labelledby="tab-badminton" tabindex="0" style="--c: var(--lime)" hidden>
      <p class="big-line">{badminton.line}</p>
      <div class="photos">
        {
          Array.from({ length: badminton.photoSlots }, () => (
            <div class="photo">
              <span>Photo coming soon</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tabs */
  .tablist {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 40px;
  }
  .tab {
    all: unset;
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 16px;
    border: 2px solid var(--c);
    color: var(--fg);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tab:hover {
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .tab[aria-selected='true'] {
    background: var(--c);
    color: var(--ink);
  }
  .tab:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  .tn {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.75;
  }
  .tl {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(16px, 2vw, 22px);
  }

  .panel {
    display: grid;
    gap: 44px;
  }
  .panel[hidden] {
    display: none !important;
  }
  .panel:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 8px;
    border-radius: 8px;
  }
  /* Shared type, matching the rest of the site */
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 22px;
  }
  .sec-title {
    font-size: clamp(36px, 5vw, 60px);
  }
  .sec-title.sm {
    font-size: clamp(30px, 3.6vw, 44px);
  }
  .item-name {
    margin: 0;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 22px;
    line-height: 1.1;
  }
  .item-note {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  /* Music */
  .about {
    display: grid;
    gap: 18px;
  }
  .about p {
    margin: 0;
    max-width: 68ch;
    font-size: 19px;
    line-height: 1.65;
    color: var(--muted);
  }
  .about p.lead {
    max-width: 36em;
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(21px, 2.4vw, 30px);
    line-height: 1.18;
    color: var(--fg);
  }
  .top5 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: 12px;
  }
  .artist {
    display: grid;
    align-content: space-between;
    gap: 18px;
    min-height: 150px;
    padding: 18px;
    border: 1.5px solid var(--line);
    border-radius: 16px;
    min-width: 0;
  }
  .artist.first {
    min-height: 200px;
    padding: 24px;
    background: var(--c);
    border-color: var(--c);
    color: var(--ink);
  }
  .rank {
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 0.9;
    color: var(--c);
  }
  .first .rank {
    font-size: 64px;
    color: var(--ink);
  }
  .name {
    font-family: var(--font-sticker);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.05;
  }
  .first .name {
    font-size: clamp(24px, 2.6vw, 32px);
  }
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .albums li {
    display: grid;
    align-content: space-between;
    gap: 18px;
    min-height: 150px;
    padding: 18px;
    border: 1.5px solid var(--line);
    border-top: 4px solid var(--c);
    border-radius: 16px;
  }
  .albums .item-name {
    font-size: clamp(18px, 1.8vw, 22px);
  }
  .rows,
  .routes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .rows li:first-child {
    padding-top: 0;
  }
  .routes li {
    display: block;
  }
  .ride-lists {
    display: grid;
    gap: 32px;
  }
  .list-head {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }
  .routes .item-name,
  .routes .item-note {
    display: block;
  }

  /* Facts strip (biking, drums) */
  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    border-top: 3px solid var(--c);
    border-bottom: 1px solid var(--line);
  }
  .fact {
    flex: 1 1 160px;
    padding: 18px 22px 20px;
    border-left: 1px solid var(--line);
  }
  .fact:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .fact.wide {
    flex: 2 1 300px;
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact dd {
    margin: 8px 0 0;
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1;
    color: var(--c);
    text-transform: uppercase;
  }
  .fact.wide dd {
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.1;
  }

  /* Biking */
  .bike {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .map {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .swipe {
    display: none;
    color: var(--c);
  }
  .cap {
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: #151313;
  }

  /* Drums */
  .kit {
    padding: 12px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  /* Badminton */
  .big-line {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .photo {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: 18px;
    border: 2px dashed color-mix(in srgb, var(--c) 55%, transparent);
    background: var(--surface);
  }
  .photo span {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .bike {
      grid-template-columns: 1fr;
    }
    .albums {
      grid-template-columns: 1fr 1fr;
    }
    .top5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .artist.first {
      grid-column: 1 / -1;
      min-height: 0;
    }
    .artist {
      min-height: 120px;
    }
  }
  @media (max-width: 600px) {
    .tablist {
      grid-template-columns: 1fr 1fr;
      margin-bottom: 32px;
    }
    .panel {
      gap: 36px;
    }
    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .fact,
    .fact:first-child {
      padding: 16px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .fact:nth-child(even) {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
    .fact.wide {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: 0;
      border-bottom: 0;
    }
    .facts > .fact:last-child:not(.wide) {
      border-bottom: 0;
    }
    .photos {
      grid-template-columns: 1fr;
    }
    .swipe {
      display: inline;
    }
    .map-scroll :global(.ridemap) {
      width: 640px;
      max-width: none;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const ids = tabs.map((t) => t.dataset.tab!);

    const select = (id: string, focus = false, push = true) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        if (on && focus) t.focus();
      });
      if (push) history.replaceState(null, '', `#${id}`);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(ids[j], true);
      });
    });

    const fromHash = () => {
      const h = location.hash.slice(1);
      if (ids.includes(h)) select(h, false, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
