---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { nowRepos, ACTIVE_DAYS, projectNotes } from '../data/now';
import { getProjects, colorVar } from '../lib/projects';
import synced from '../data/now.json';

type Commit = { sha: string; date: string; subject: string };
type Activity = { branch: string; total: number; last30: number; commits: Commit[] };
const activity = synced.repos as Record<string, Activity>;
const gh = (repo: string) => `https://github.com/${repo}`;
const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });

// Projects: one card each, most recently pushed first. They stack as you scroll.
const projects = await getProjects();
const cards = nowRepos
  .filter((r) => r.part === 'build')
  .map((r) => {
    const p = r.project ? projects.find((x) => x.id === r.project) : undefined;
    const a = activity[r.repo];
    return {
      ...r,
      title: p?.data.title ?? r.name,
      letter: p?.data.letter ?? r.name.charAt(0).toUpperCase(),
      color: p ? colorVar(p.data.color) : 'var(--orange)',
      status: p?.data.status ?? 'Live',
      summary: p?.data.summary ?? r.description,
      last: a?.commits[0],
      month: a?.last30 ?? 0,
      note: projectNotes[r.repo] ?? {},
    };
  })
  .sort((x, y) => Date.parse(y.last?.date ?? '0') - Date.parse(x.last?.date ?? '0'));

---

<BaseLayout title="Now" description="What Jake Roberts is working on right now: every project, where it stands and its last push.">
  <PageIntro
    number="04"
    title="Now"
    lede="What I'm working on right now. Every project, where it stands and its last push, read straight from GitHub."
  />

  <section class="container" aria-labelledby="projects-title">
    <div class="sec-head">
      <h2 id="projects-title" class="display sec-title">Projects</h2>
      <span class="label">Most recent push first</span>
    </div>

    <ol class="stack">
      {
        cards.map((c, i) => (
          <li class="slot" style={`--i: ${i}`}>
            <article class="card" style={`--c: ${c.color}`} aria-labelledby={`p-${c.repo}`} data-card>
              <span class="c-mark" aria-hidden="true">{c.letter}</span>
              <header class="c-top">
                <span class="c-letter" aria-hidden="true">{c.letter}</span>
                <span class="c-kind">{c.status}</span>
                <span class="c-count">
                  {String(i + 1).padStart(2, '0')} / {String(cards.length).padStart(2, '0')}
                </span>
                <span class="c-month">
                  {c.month > 0 ? `${c.month} commits this month` : `quiet for ${ACTIVE_DAYS}+ days`}
                </span>
              </header>
              <h3 id={`p-${c.repo}`} class="c-title display">{c.title}</h3>
              <p class="c-summary">{c.summary}</p>
              <dl class="c-rows">
                {c.note.stuck && (
                  <div class="c-row">
                    <dt><span class="badge">Stuck on</span></dt>
                    <dd class="strong">{c.note.stuck}</dd>
                  </div>
                )}
                <div class="c-row">
                  <dt>Last push</dt>
                  <dd>
                    {c.last ? (
                      <>
                        <a class="p-msg" href={`${gh(c.repo)}/commit/${c.last.sha}`} rel="noopener">
                          {c.last.subject}
                        </a>
                        <span class="p-meta">
                          <code>{c.last.sha}</code> · <span data-ago={c.last.date}>{fmt(c.last.date)}</span>
                        </span>
                      </>
                    ) : (
                      'Nothing pushed yet'
                    )}
                  </dd>
                </div>
                {c.note.next && (
                  <div class="c-row">
                    <dt>Next up</dt>
                    <dd>{c.note.next}</dd>
                  </div>
                )}
              </dl>
              <div class="c-links">
                {c.project && <a href={`/projects/${c.project}`}>Case study →</a>}
                <a href={gh(c.repo)} rel="noopener">GitHub ↗</a>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </section>


  <p class="container synced">Synced from GitHub <span data-ago={synced.syncedAt}>{fmt(synced.syncedAt)}</span>.</p>
</BaseLayout>

<style>
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--fg);
    margin-bottom: 22px;
  }
  .sec-title {
    font-size: clamp(36px, 5vw, 60px);
  }

  /* Project cards stick as you scroll, so each new one slides up over the last. */
  .stack {
    list-style: none;
    margin: 0;
    padding: 0 0 24px;
    display: grid;
    gap: 22px;
  }
  .slot {
    position: sticky;
    top: calc(20px + var(--i) * 14px);
  }

  .card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transform-origin: 50% 0;
    will-change: transform, filter;
    display: grid;
    gap: 12px;
    padding: 24px 26px 20px;
    border-radius: 22px;
    background-color: var(--panel);
    background-image:
      linear-gradient(var(--panel-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--panel-grid) 1px, transparent 1px);
    background-size: 40px 40px;
    color: var(--ink);
    box-shadow:
      inset 0 8px 0 var(--c),
      0 -10px 30px rgba(0, 0, 0, 0.35);
    min-width: 0;
  }
  /* Big project letter in the card's colour, sitting behind the content. */
  .c-mark {
    position: absolute;
    right: -0.04em;
    bottom: -0.32em;
    z-index: -1;
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: clamp(200px, 26vw, 320px);
    line-height: 1;
    color: var(--c);
    opacity: 0.9;
    transform: rotate(-8deg);
    pointer-events: none;
    user-select: none;
  }
  .c-count {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: #4a4642;
  }
  .c-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 6px;
  }
  .c-letter {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c);
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 22px;
    transform: rotate(-6deg);
  }
  .c-kind {
    padding: 3px 10px;
    border-radius: 99px;
    border: 1.5px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .c-month {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: #4a4642;
  }
  .c-title {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 0.95;
  }
  .c-summary {
    margin: 0;
    max-width: 58ch;
    font-size: 16px;
    line-height: 1.5;
    color: #3a3632;
  }
  .c-rows {
    margin: 4px 0 0;
    display: grid;
    max-width: 640px;
  }
  .c-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 0;
    border-top: 1.5px solid rgba(17, 17, 18, 0.15);
  }
  .c-row dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4a4642;
    padding-top: 3px;
  }
  .c-row dd {
    margin: 0;
    display: grid;
    gap: 2px;
    font-size: 15.5px;
    line-height: 1.5;
    min-width: 0;
  }
  .strong {
    font-weight: 500;
  }
  .badge {
    display: inline-block;
    padding: 3px 8px 2px;
    border-radius: 6px;
    background: var(--c);
    color: var(--ink);
    font-family: var(--font-sticker);
    font-weight: 800;
    font-size: 11.5px;
    transform: rotate(-3deg);
  }
  .p-msg {
    font-family: var(--font-mono);
    font-size: 13.5px;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .p-msg:hover {
    text-decoration: underline;
  }
  .p-meta {
    font-size: 12.5px;
    color: #5e5a55;
  }
  .p-meta code {
    font-family: var(--font-mono);
  }
  .pushes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .pushes li {
    display: grid;
    gap: 2px;
  }
  .c-links {
    max-width: 640px;
    display: flex;
    gap: 18px;
    padding-top: 12px;
    border-top: 1.5px solid rgba(17, 17, 18, 0.15);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .c-links a {
    text-decoration: none;
    border-bottom: 1.5px solid var(--c);
  }

  .synced {
    padding-top: 40px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .card {
      padding: 22px 18px 18px;
    }
    .slot {
      top: calc(12px + var(--i) * 10px);
    }
    .c-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .c-month {
      margin-left: 0;
      width: 100%;
    }
    .c-mark {
      opacity: 0.22;
    }
    .s-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
</style>

<script>
  // As each project card slides over the one before, the cards behind shrink, tilt back and dim.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  let queued = false;
  const depth = () => {
    queued = false;
    cards.forEach((card, i) => {
      const next = cards[i + 1];
      if (!next || still.matches) {
        card.style.transform = '';
        card.style.filter = '';
        return;
      }
      const a = card.getBoundingClientRect();
      const b = next.getBoundingClientRect();
      // 0 when the next card is just touching, 1 when it has fully slid over this one.
      const p = Math.min(1, Math.max(0, (a.bottom - b.top) / a.height));
      card.style.transform = p ? `perspective(1400px) rotateX(${(p * 7).toFixed(2)}deg) scale(${(1 - p * 0.07).toFixed(3)})` : '';
      card.style.filter = p ? `brightness(${(1 - p * 0.32).toFixed(3)}) saturate(${(1 - p * 0.3).toFixed(3)})` : '';
    });
  };
  const onScroll = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(depth);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  still.addEventListener('change', onScroll);
  depth();

  // "3 days ago" style times, worked out in the visitor's browser so they stay accurate between builds.
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ['year', 31536e6],
    ['month', 2592e6],
    ['week', 6048e5],
    ['day', 864e5],
    ['hour', 36e5],
    ['minute', 6e4],
  ];
  document.querySelectorAll<HTMLElement>('[data-ago]').forEach((el) => {
    const t = Date.parse(el.dataset.ago!);
    if (Number.isNaN(t)) return;
    const diff = t - Date.now();
    const [unit, ms] = units.find(([, ms]) => Math.abs(diff) >= ms) ?? ['minute', 6e4];
    el.title = el.textContent ?? '';
    el.textContent = rtf.format(Math.round(diff / ms), unit);
  });
</script>
