---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { site } from '../site';
---

<BaseLayout>
  <section class="hero container">
    <h1 class="display headline">{site.title}</h1>
    <p class="lede">{site.description}</p>
  </section>
  <ComingSoon step="step 3 (grid panel and stickers)" />
</BaseLayout>

<style>
  .hero {
    padding-top: 24px;
    padding-bottom: 32px;
    display: grid;
    gap: 20px;
  }
  .headline {
    font-size: clamp(56px, 13.6vw, 160px);
  }
  .lede {
    margin: 0;
    color: var(--muted);
    max-width: 50ch;
    font-size: 17px;
  }
</style>
