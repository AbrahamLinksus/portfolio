---
import '../styles/global.css';
import Header from '../components/Header.astro';
import FullMenu from '../components/FullMenu.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;

// Link-preview image: public/og/<page>.png, made by scripts/og.mjs. '/projects/x' -> 'projects-x'.
const path = Astro.url.pathname.replace(/\/$/, '');
const ogKey = path === '' ? 'home' : path.slice(1).replace(/\//g, '-');
const ogKeys = import.meta.glob('/public/og/*.png');
const ogFile = `/og/${ogKeys[`/public/og/${ogKey}.png`] ? ogKey : 'home'}.png`;
const canonical = new URL(path || '/', Astro.site);
const ogImage = new URL(ogFile, Astro.site);

// Tells search engines who this site is about (homepage only).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: Astro.site?.href,
  sameAs: site.socials.map((s) => s.href),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'SRM Institute of Science and Technology' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0e0e0f" />
    <meta name="author" content={site.name} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Link previews (LinkedIn, WhatsApp, Slack, X) -->
    <meta property="og:type" content={path.startsWith('/projects/') ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {path === '' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@900&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <FullMenu />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    background: var(--fg);
    color: var(--bg);
    padding: 8px 12px;
    border-radius: 6px;
    z-index: 100;
  }
  .skip:focus {
    top: 12px;
  }
</style>
