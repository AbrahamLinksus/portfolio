# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain you've verified in Resend.
# Until then, Resend's test sender works but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Public site URL for metadata, sitemap and OG images. Optional on Vercel:
# the production domain is detected automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
